---
/**
 * 生活记录 —— 四个分类
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionTitle from "../components/SectionTitle.astro";
import Media from "../components/Media.astro";

const cats = [
  { label: "汉服与审美", desc: "衣冠之美，也是一种表达", ph: "rose", cover: "/media/note-hanfu.jpg" },
  { label: "旅行与城市", desc: "在路上观察不同的生活方式", ph: "sage", cover: "/media/note-travel.jpg" },
  { label: "生活灵感", desc: "日常里捡到的小小闪光", ph: "warm", cover: "/media/note-inspiration.jpg" },
  { label: "内容复盘", desc: "记录与写作本身的回顾", ph: "blue", cover: "/media/note-review.jpg" },
] as const;
---

<BaseLayout title="生活记录">
  <section class="mx-auto max-w-[1400px] px-5 py-16 md:px-10 md:py-24">
    <SectionTitle title="生活记录" subtitle="不止职场，也记录生活。" />

    <div data-reveal class="mt-12 grid gap-5 sm:grid-cols-2 md:grid-cols-4">
      {
        cats.map((c) => (
          <div class="group">
            <Media src={c.cover} ph={c.ph} class="aspect-[4/5] w-full rounded-2xl" />
            <p class="mt-3 text-[17px] font-semibold">{c.label}</p>
            <p class="mt-1 text-[14px] text-muted">{c.desc}</p>
          </div>
        ))
      }
    </div>
  </section>
</BaseLayout>
