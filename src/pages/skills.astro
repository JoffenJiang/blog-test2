---
/**
 * /skills —— 技能干货
 * 首屏（白底）：全部文章轮播——左上中文分类眉题 + 30px 标题 + 15px 简介，
 *   右侧大图；27px 蓝色圆钮固定在左下（不随轮播移动），图片底部与圆钮底部对齐；
 *   每次完整展示一个主题，自动向左无缝循环，手动切换后重新计时
 * 下方：细长分类胶囊过滤栏 + 三列文章卡片网格
 * 数据来源：src/content/skills 内容集合
 */
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Media from "../components/Media.astro";
import { skillCategories } from "../data/categories";

const posts = (await getCollection("skills")).sort(
  (a, b) => a.data.order - b.data.order
);
---

<BaseLayout
  title="技能干货"
  description="从真实工作里长出来的技能树：飞书、设计、财税合规、市场活动、个人理财、产品经理和 AI 应用。"
  headerTone="white"
  footerTone="bg"
>
  <!-- ===== 首屏轮播（白底） ===== -->
  <section class="sk-hero" data-sk-hero>
    <div class="sk-hero__viewport">
      <div class="sk-hero__track" data-sk-track>
        {
          posts.map((post) => (
            <article class="sk-hero__slide">
              <div class="sk-hero__text">
                <p class="sk-hero__eyebrow">{post.data.category}</p>
                <h2 class="sk-hero__title font-serif">
                  <a href={`/skills/${post.id}`}>{post.data.title}</a>
                </h2>
                <p class="sk-hero__excerpt">{post.data.excerpt}</p>
              </div>
              <a
                class="sk-hero__media"
                href={`/skills/${post.id}`}
                aria-label={post.data.title}
              >
                <Media src={post.data.cover} ph={post.data.ph} class="sk-hero__img" />
              </a>
            </article>
          ))
        }
      </div>
    </div>

    <!-- 圆钮固定在左下，不随轮播移动；底部与图片底部对齐 -->
    <div class="sk-hero__nav">
      <button type="button" class="sk-hero__arrow" data-sk-prev aria-label="上一篇">
        <svg viewBox="0 0 14 14" fill="none">
          <path d="M9 2.5 4.5 7 9 11.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </button>
      <button type="button" class="sk-hero__arrow" data-sk-next aria-label="下一篇">
        <svg viewBox="0 0 14 14" fill="none">
          <path d="M5 2.5 9.5 7 5 11.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </button>
    </div>
  </section>

  <!-- ===== 分类过滤 + 文章卡片网格 ===== -->
  <section class="sk-grid-section" data-sk-filter>
    <div class="sk-grid-section__inner">
      <div class="sk-cats" role="group" aria-label="文章分类">
        {
          skillCategories.map((cat, i) => (
            <button
              type="button"
              class:list={["sk-cat", i === 0 && "is-active"]}
              data-cat={cat}
              aria-pressed={i === 0 ? "true" : "false"}
            >
              {cat}
            </button>
          ))
        }
      </div>

      <div class="sk-grid">
        {
          posts.map((post) => (
            <article class="sk-card group" data-cat={post.data.category}>
              <a
                class="sk-card__media"
                href={`/skills/${post.id}`}
                aria-label={post.data.title}
              >
                <Media
                  src={post.data.cover}
                  ph={post.data.ph}
                  class="sk-card__img transition-transform duration-500 ease-out group-hover:scale-[0.94]"
                />
                <span class="sk-card__go">
                  <svg viewBox="0 0 14 14" fill="none" aria-hidden="true">
                    <path
                      d="M3 11 11 3M4.5 3H11v6.5"
                      stroke="currentColor"
                      stroke-width="1.6"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                </span>
              </a>
              <div class="sk-card__meta">
                <span class="sk-card__tag">{post.data.category}</span>
                <span class="sk-card__time num">{post.data.readTime}</span>
              </div>
              <h3 class="sk-card__title">
                <a href={`/skills/${post.id}`}>{post.data.title}</a>
              </h3>
            </article>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ===== 首屏轮播：白底 ===== */
  .sk-hero {
    position: relative;
    background: #fff;
    padding: clamp(40px, 7vh, 80px) 0 160px;
  }

  .sk-hero__viewport {
    overflow: hidden;
  }

  .sk-hero__track {
    display: flex;
    transition: transform 0.65s cubic-bezier(0.45, 0.05, 0.2, 1);
  }

  /* 每张占满轮播视口，避免同时露出下一个主题 */
  .sk-hero__slide {
    flex: 0 0 100%;
    min-width: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr) min(480px, 38vw);
    gap: clamp(32px, 5vw, 80px);
    align-items: end;
    padding: 0 clamp(24px, 5vw, 80px);
  }

  /* 文字块贴顶（与 Wildbran 一致），图片贴底 */
  .sk-hero__text {
    align-self: start;
  }

  /* 眉题：中文分类 */
  .sk-hero__eyebrow {
    font-size: 18px;
    letter-spacing: 0.2em;
    color: var(--color-muted);
  }

  .sk-hero__title {
    margin-top: 16px;
    font-size: 40px;
    font-weight: 600;
    line-height: 1.35;
    letter-spacing: -0.01em;
  }

  .sk-hero__title a {
    transition: opacity 0.2s ease;
  }

  .sk-hero__title a:hover {
    opacity: 0.75;
  }

  .sk-hero__excerpt {
    margin-top: 16px;
    max-width: 460px;
    font-size: 15px;
    line-height: 1.85;
    color: rgba(36, 36, 36, 0.7);
  }

  .sk-hero__media {
    display: block;
  }

  .sk-hero__media :global(.sk-hero__img) {
    aspect-ratio: 4 / 3;
    width: 100%;
    border-radius: 6px;
    transition: transform 0.5s ease;
  }

  .sk-hero__media:hover :global(.sk-hero__img) {
    transform: scale(0.97);
  }

  /* 27px 蓝色圆钮：固定左下，底部与图片底部（轮播底边）对齐 */
  .sk-hero__nav {
    position: absolute;
    left: clamp(24px, 5vw, 80px);
    bottom: 160px;
    display: flex;
    gap: 8px;
  }

  .sk-hero__arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 27px;
    height: 27px;
    border-radius: 50%;
    background: var(--color-blue);
    color: #fff;
    cursor: pointer;
    transition: transform 0.2s ease;
  }

  .sk-hero__arrow:hover {
    transform: scale(1.15);
  }

  .sk-hero__arrow svg {
    width: 13px;
    height: 13px;
  }

  @media (max-width: 767px) {
    .sk-hero__slide {
      grid-template-columns: 1fr;
      gap: 24px;
    }

    .sk-hero__media {
      order: -1;
    }

    .sk-hero {
      padding-bottom: 80px;
    }

    .sk-hero__nav {
      bottom: 36px;
    }
  }

  /* ===== 分类过滤 + 卡片网格 ===== */
  .sk-grid-section {
    background: var(--color-bg);
    padding: clamp(40px, 6vh, 64px) 20px clamp(80px, 12vh, 140px);
  }

  .sk-grid-section__inner {
    max-width: 1180px;
    margin: 0 auto;
  }

  /* 分类胶囊：细长（高度窄），居中，选中蓝底白字 */
  .sk-cats {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
  }

  /* 默认无填充（透出页面背景），选中才填蓝色 */
  .sk-cat {
    padding: 5px 16px;
    border-radius: 999px;
    border: 1px solid var(--color-border);
    background: transparent;
    font-size: 13px;
    line-height: 1.5;
    color: var(--color-ink);
    cursor: pointer;
    transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }

  .sk-cat:hover {
    border-color: rgba(31, 31, 31, 0.3);
  }

  .sk-cat.is-active {
    background: var(--color-blue);
    border-color: var(--color-blue);
    color: #fff;
  }

  /* 三列卡片网格 */
  .sk-grid {
    margin-top: 40px;
    display: grid;
    gap: 20px;
  }

  @media (min-width: 640px) {
    .sk-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .sk-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .sk-card {
    border-radius: 10px;
    background: #e4e0d4;
    padding: 12px 12px 24px;
  }

  .sk-card.is-hidden {
    display: none;
  }

  .sk-card__media {
    position: relative;
    display: block;
    overflow: hidden;
    border-radius: 8px;
  }

  .sk-card__media :global(.sk-card__img) {
    aspect-ratio: 4 / 3;
    width: 100%;
    border-radius: 8px;
  }

  /* 右下白色圆形 ↗ 按钮 */
  .sk-card__go {
    position: absolute;
    right: 14px;
    bottom: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: #fff;
    color: var(--color-ink);
  }

  .sk-card__go svg {
    width: 15px;
    height: 15px;
    transition: transform 0.3s ease;
  }

  .sk-card:hover .sk-card__go svg {
    transform: translate(2px, -2px);
  }

  .sk-card__meta {
    margin-top: 14px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 6px;
  }

  /* 细长分类小标签 */
  .sk-card__tag {
    padding: 3px 10px;
    border-radius: 999px;
    background: rgba(63, 111, 255, 0.12);
    font-size: 11px;
    font-weight: 500;
    line-height: 1.4;
    color: var(--color-blue);
  }

  .sk-card__time {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--color-muted);
  }

  .sk-card__title {
    margin-top: 12px;
    padding: 0 6px;
    font-size: 15px;
    font-weight: 600;
    line-height: 1.5;
  }

  .sk-card__title a:hover {
    opacity: 0.75;
  }

  @media (prefers-reduced-motion: reduce) {
    .sk-hero__track {
      transition: none;
    }
  }
</style>

<script>
  // ===== 首屏轮播：整屏展示 + 首尾镜像卡片无缝循环 =====
  const hero = document.querySelector<HTMLElement>("[data-sk-hero]");
  const track = hero?.querySelector<HTMLElement>("[data-sk-track]");
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (hero && track) {
    const realSlides = [...track.children] as HTMLElement[];
    const slideCount = realSlides.length;
    let timer: ReturnType<typeof setInterval> | undefined;

    if (slideCount > 1) {
      const makeClone = (slide: HTMLElement) => {
        const clone = slide.cloneNode(true) as HTMLElement;
        clone.setAttribute("aria-hidden", "true");
        clone.dataset.skClone = "";
        clone
          .querySelectorAll<HTMLElement>("a, button, input, select, textarea, [tabindex]")
          .forEach((element) => element.setAttribute("tabindex", "-1"));
        return clone;
      };

      /* 末张放到最前、首张放到最后，使两个方向都能自然跨过边界。 */
      track.prepend(makeClone(realSlides[slideCount - 1]));
      track.append(makeClone(realSlides[0]));

      let index = 1;
      let moving = false;

      const render = (animate: boolean) => {
        track.style.transition = animate ? "" : "none";
        track.style.transform = `translate3d(${-index * 100}%, 0, 0)`;

        if (!animate) {
          /* 先完成无动画跳转，再恢复下一次滑动所需的过渡。 */
          track.getBoundingClientRect();
          track.style.transition = "";
        }
      };

      const go = (dir: number) => {
        if (moving) return;

        if (reduce) {
          index = ((index - 1 + dir + slideCount) % slideCount) + 1;
          render(false);
          return;
        }

        moving = true;
        index += dir;
        render(true);
      };

      const restart = () => {
        if (reduce) return;
        clearInterval(timer);
        timer = setInterval(() => go(1), 4000);
      };

      track.addEventListener("transitionend", (event) => {
        if (event.target !== track || event.propertyName !== "transform") return;

        moving = false;
        if (index === 0) {
          index = slideCount;
          render(false);
        } else if (index === slideCount + 1) {
          index = 1;
          render(false);
        }
      });

      hero.querySelector("[data-sk-prev]")?.addEventListener("click", () => {
        go(-1);
        restart();
      });
      hero.querySelector("[data-sk-next]")?.addEventListener("click", () => {
        go(1);
        restart();
      });

      render(false);
      restart();
    }
  }

  // ===== 分类过滤：点击胶囊即时过滤卡片 =====
  const filterRoot = document.querySelector<HTMLElement>("[data-sk-filter]");

  if (filterRoot) {
    const buttons = [...filterRoot.querySelectorAll<HTMLButtonElement>(".sk-cat")];
    const cards = [...filterRoot.querySelectorAll<HTMLElement>(".sk-card")];

    for (const btn of buttons) {
      btn.addEventListener("click", () => {
        const cat = btn.dataset.cat;
        for (const b of buttons) {
          const active = b === btn;
          b.classList.toggle("is-active", active);
          b.setAttribute("aria-pressed", String(active));
        }
        for (const card of cards) {
          card.classList.toggle(
            "is-hidden",
            cat !== "全部" && card.dataset.cat !== cat
          );
        }
      });
    }
  }
</script>
