---
/**
 * 技能干货列表 —— 全部文章卡片
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionTitle from "../components/SectionTitle.astro";
import Media from "../components/Media.astro";
import { posts } from "../data/posts";
---

<BaseLayout title="技能干货">
  <section class="mx-auto max-w-[1400px] px-5 py-16 md:px-10 md:py-24">
    <SectionTitle
      title="技能干货"
      subtitle="从真实工作里长出来的技能树。"
      lead="这些文章来自真实的工作场景：方法、流程和工具笔记，都验证过一遍才写下来。"
    />

    <div data-reveal class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {
        posts.map((post) => (
          <article class="group rounded-lg bg-[#e4e0d4] p-3">
            <span class="relative block overflow-hidden rounded-md">
              <Media
                src={post.cover}
                ph={post.ph}
                class="aspect-[4/3] w-full transition-transform duration-500 ease-out group-hover:scale-[0.94]"
              />
              <span class="absolute bottom-3 right-3 flex h-10 w-10 items-center justify-center rounded-full bg-white text-ink transition-transform duration-300 ease-out group-hover:translate-x-1.5 group-hover:scale-[0.85]">
                <svg class="h-4 w-4" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                  <path
                    d="M3 11 11 3M4.5 3H11v6.5"
                    stroke="currentColor"
                    stroke-width="1.6"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </span>
            </span>
            <span class="mt-4 flex items-center justify-between px-1">
              <span class="rounded-full bg-blue/10 px-3 py-1 text-[12px] font-medium text-blue">
                {post.category}
              </span>
              <span class="num text-[11px] uppercase tracking-[0.15em] text-muted">
                {post.readTime}
              </span>
            </span>
            <h2 class="mt-3 truncate px-1 pb-2 text-[17px] font-semibold leading-snug">{post.title}</h2>
          </article>
        ))
      }
    </div>

    <p data-reveal class="mt-12 text-[14px] text-muted">正文内容整理中，敬请期待。</p>
  </section>
</BaseLayout>
