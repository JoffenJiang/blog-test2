---
/**
 * 技能干货列表 —— 全部文章卡片
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionTitle from "../components/SectionTitle.astro";
import Media from "../components/Media.astro";
import { posts } from "../data/posts";
---

<BaseLayout title="技能干货">
  <section class="mx-auto max-w-[1400px] px-5 py-16 md:px-10 md:py-24">
    <SectionTitle
      title="技能干货"
      subtitle="从真实工作里长出来的技能树。"
      lead="这些文章来自真实的工作场景：方法、流程和工具笔记，都验证过一遍才写下来。"
    />

    <div data-reveal class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {
        posts.map((post) => (
          <article class="group rounded-2xl border border-border bg-paper p-3 transition duration-200 hover:-translate-y-1">
            <span class="relative block overflow-hidden rounded-xl">
              <Media src={post.cover} ph={post.ph} class="aspect-[4/3] w-full" />
            </span>
            <span class="mt-4 flex items-center justify-between px-1">
              <span class="rounded-full bg-blue/10 px-3 py-1 text-[12px] font-medium text-blue">
                {post.category}
              </span>
              <span class="num text-[11px] uppercase tracking-[0.15em] text-muted">
                {post.readTime}
              </span>
            </span>
            <h2 class="mt-3 px-1 pb-2 text-[17px] font-semibold leading-snug">{post.title}</h2>
          </article>
        ))
      }
    </div>

    <p data-reveal class="mt-12 text-[14px] text-muted">正文内容整理中，敬请期待。</p>
  </section>
</BaseLayout>
