---
/**
 * 联系我 —— 小红书 / 邮箱先用文字占位
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionTitle from "../components/SectionTitle.astro";
---

<BaseLayout title="联系我">
  <section class="mx-auto max-w-[1400px] px-5 py-16 md:px-10 md:py-24">
    <SectionTitle
      title="联系我"
      lead="想交流职业发展、技能学习或资源整理，欢迎通过下面的方式找到我。"
    />

    <div data-reveal class="mt-12 grid max-w-[720px] gap-5 sm:grid-cols-2">
      <div class="rounded-2xl bg-card p-7">
        <p class="font-serif text-[20px] font-semibold">小红书</p>
        <p class="mt-2 text-[14px] text-muted">链接整理中</p>
      </div>
      <div class="rounded-2xl bg-card p-7">
        <p class="font-serif text-[20px] font-semibold">邮箱</p>
        <p class="mt-2 text-[14px] text-muted">联系方式整理中</p>
      </div>
    </div>
  </section>
</BaseLayout>
