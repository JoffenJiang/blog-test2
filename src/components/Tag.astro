---
/**
 * Tag —— 标签
 * default: 细边框小标签（分类、关键词）
 * warm: 暖调「贴纸」标签（手账感，用在生活杂记等柔和区域）
 */
interface Props {
  variant?: "default" | "warm";
  class?: string;
}

const { variant = "default", class: className = "" } = Astro.props;

const styles =
  variant === "warm"
    ? "bg-warm/70 text-ink"
    : "border border-border bg-paper text-muted";
---

<span
  class:list={[
    "inline-flex items-center rounded-full px-2.5 py-0.5 text-[13px] leading-relaxed",
    styles,
    className,
  ]}
>
  <slot />
</span>
