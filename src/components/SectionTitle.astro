---
/**
 * SectionTitle —— 宋体大标题 + 副标题 + 引言，无装饰线
 * 自带 data-reveal 进场
 */
interface Props {
  title: string;
  subtitle?: string;
  lead?: string;
  align?: "left" | "center";
  class?: string;
}

const { title, subtitle, lead, align = "left", class: className = "" } = Astro.props;
---

<div data-reveal class:list={[align === "center" && "text-center", className]}>
  <h2 class="font-serif text-[30px] font-bold md:text-[40px]">{title}</h2>
  {subtitle && <p class="mt-2 text-[17px] text-muted md:text-[19px]">{subtitle}</p>}
  {
    lead && (
      <p
        class:list={[
          "mt-5 max-w-[640px] text-[16px] leading-[1.9] text-muted",
          align === "center" && "mx-auto",
        ]}
      >
        {lead}
      </p>
    )
  }
</div>
