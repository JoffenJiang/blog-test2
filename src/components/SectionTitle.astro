---
/**
 * SectionTitle —— 标题 + 副标题 + 引言，无装饰线
 * 自带 data-reveal 进场
 */
interface Props {
  title: string;
  subtitle?: string;
  lead?: string;
  class?: string;
}

const { title, subtitle, lead, class: className = "" } = Astro.props;
---

<div data-reveal class:list={[className]}>
  <h2 class="text-[26px] font-bold md:text-[34px]">{title}</h2>
  {subtitle && <p class="mt-2 text-[18px] text-muted md:text-[20px]">{subtitle}</p>}
  {
    lead && (
      <p class="mt-5 max-w-[640px] text-[16px] leading-[1.9] text-muted">
        {lead}
      </p>
    )
  }
</div>
