---
/**
 * PillButton —— 蓝色胶囊按钮（Wildbran 式统一规格 + hover 动效）
 *
 * 统一规格：高度固定 44px，宽度随文字自适应，字号统一 15px
 * hover 动效（离开时反向复原）：
 *   文字：上下两份叠放在裁切容器内，hover 时整列向上滚动一行
 *   图标：圆形容器内两份图标，hover 时当前份向右滚出、另一份从左滚入
 *
 * variant:
 *   blue —— 实心蓝底白字 + 白色圆形图标（默认）
 *   hero —— 半透明深蓝底白字 + 实心蓝色圆形图标（视频首屏用）
 * icon:
 *   chevron  —— 细线右向 chevron（默认）
 *   play     —— 播放三角（视频按钮）
 *   download —— 下载箭头（简历下载按钮）
 */
interface Props {
  href: string;
  label: string;
  variant?: "blue" | "hero";
  icon?: "chevron" | "play" | "download";
  /** 下载链接（如简历 PDF）时置为 true */
  download?: boolean;
  class?: string;
}

const {
  href,
  label,
  variant = "blue",
  icon = "chevron",
  download = false,
  class: className = "",
} = Astro.props;
---

<a
  href={href}
  download={download || undefined}
  class:list={["pillx", `pillx--${variant}`, className]}
>
  <span class="pillx__mask">
    <span class="pillx__col">
      <span class="pillx__text">{label}</span>
      <span class="pillx__text" aria-hidden="true">{label}</span>
    </span>
  </span>

  <span class="pillx__circle" aria-hidden="true">
    {
      [0, 1].map((i) => (
        <span class:list={["pillx__ic", i === 1 && "pillx__ic--copy"]}>
          {icon === "play" ? (
            <svg viewBox="0 0 16 16" fill="none">
              <path
                d="M4.6 3.9c0-.62.67-1 1.2-.7l7.1 3.9c.55.3.55 1.1 0 1.4l-7.1 3.9c-.53.3-1.2-.08-1.2-.7V3.9Z"
                stroke="currentColor"
                stroke-width="1.2"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          ) : icon === "download" ? (
            <svg viewBox="0 0 16 16" fill="none">
              <path
                d="M8 2.5v7.5M4.8 7 8 10.2 11.2 7M3.5 13h9"
                stroke="currentColor"
                stroke-width="1.2"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          ) : (
            <svg viewBox="0 0 17 17" fill="none">
              <path
                d="M6.4 3.5 11.4 8.5 6.4 13.5"
                stroke="currentColor"
                stroke-width="1.2"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          )}
        </span>
      ))
    }
  </span>
</a>

<style>
  /* ===== 统一骨架：高 44px，左字右圆，宽度自适应 ===== */
  .pillx {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    height: 44px;
    padding: 0 5px 0 22px;
    border-radius: 999px;
    font-size: 13px;
    font-weight: 500;
    line-height: 1;
  }

  .pillx--blue {
    background: var(--color-blue);
    color: #fff;
  }

  /* 视频首屏：半透明深蓝底（磨砂），圆形图标为实心蓝 */
  .pillx--hero {
    background: rgba(34, 51, 122, 0.5);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    color: #fff;
  }

  /* ===== 文字上滚 ===== */
  .pillx__mask {
    display: block;
    overflow: hidden;
    /* 裁切高度 = 单行文字高度 */
    height: 13px;
  }

  .pillx__col {
    display: flex;
    flex-direction: column;
    transition: transform 0.45s cubic-bezier(0.5, 0, 0.15, 1);
  }

  .pillx__text {
    display: block;
    height: 13px;
    line-height: 13px;
    white-space: nowrap;
  }

  .pillx:hover .pillx__col,
  .pillx:focus-visible .pillx__col {
    transform: translateY(-13px);
  }

  /* ===== 圆形图标：右滚出、左滚入 ===== */
  .pillx__circle {
    position: relative;
    flex-shrink: 0;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    overflow: hidden;
  }

  .pillx--blue .pillx__circle {
    background: #fff;
    color: var(--color-ink);
  }

  .pillx--hero .pillx__circle {
    background: var(--color-blue);
    color: #fff;
  }

  .pillx__ic {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.45s cubic-bezier(0.5, 0, 0.15, 1);
  }

  .pillx__ic svg {
    width: 16px;
    height: 16px;
  }

  .pillx__ic--copy {
    transform: translateX(-150%);
  }

  .pillx:hover .pillx__ic,
  .pillx:focus-visible .pillx__ic {
    transform: translateX(150%);
  }

  .pillx:hover .pillx__ic--copy,
  .pillx:focus-visible .pillx__ic--copy {
    transform: translateX(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .pillx__col,
    .pillx__ic {
      transition: none;
    }

    .pillx:hover .pillx__col {
      transform: none;
    }

    .pillx:hover .pillx__ic {
      transform: none;
    }

    .pillx:hover .pillx__ic--copy {
      transform: translateX(-150%);
    }
  }
</style>
