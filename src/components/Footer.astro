---
/**
 * Footer —— 页脚
 * 底色与页面背景一致（米白页 bg / 白色页 white），上下 padding 94px
 * 左列：导航栏目；右列：邮箱 / 小红书 / Instagram（先文字占位，不放假链接）
 */
import { navItems } from "../data/navigation";

interface Props {
  /** 与页面背景一致：bg 米白（默认）/ white 纯白 */
  tone?: "bg" | "white";
}

const { tone = "bg" } = Astro.props;
---

<footer class:list={[tone === "white" ? "bg-white" : "bg-bg"]}>
  <div class="mx-auto max-w-[1400px] px-5 py-[94px] md:px-10">
    <div class="flex flex-col gap-10 md:flex-row md:justify-between">
      <nav aria-label="页脚导航">
        <ul class="space-y-3 text-[15px]">
          {
            navItems.map((item) => (
              <li>
                <a href={item.href} class="text-ink/80 transition-colors hover:text-ink">
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="space-y-3 text-[15px] text-ink/80 md:text-right">
        <p>邮箱：整理中</p>
        <p>小红书：整理中</p>
        <p>Instagram：整理中</p>
      </div>
    </div>
  </div>
</footer>
