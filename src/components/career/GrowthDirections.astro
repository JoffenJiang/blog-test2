---
/**
 * GrowthDirections —— 五个能力步骤卡片 + 调侃总结卡（Wildbran hsteps 式）
 *
 * 六张卡片版式各异、宽高不一（棕红 / 米灰交替，最后一张克莱因蓝）：
 *   1 宽幅棕卡：右上小字说明，中间占位图溢出下边缘，左下衬线大字，右下 Step 1
 *   2 竖幅米卡：左上 Step 2 + 蓝色手绘对话气泡，中下棕色衬线大字 + 手写小注
 *   3 宽幅棕卡：左上白色衬线大字，右上 Step 3，左下小字，拍立得溢出上边缘，圆件溢出右边缘
 *   4 中幅米卡：占位圆件溢出上边缘，底部衬线大字 + Step 4
 *   5 宽幅棕卡：左上衬线字 + 右上 Step 5，中间占位图，左下小字
 *   6 蓝色调侃卡：白色衬线大字 + 左下小字 + 右侧歪斜拍立得
 *
 * 桌面端：sticky 舞台，纵向滚动驱动横向推进（横向滚完页面才继续下滚）
 * 移动端：原生横向滚动 + scroll-snap
 * 占位图（.gd-ph*）后续可换成真实图片
 */
---

<section class="career-growth" data-growth>
  <div class="career-growth__sticky">
    <div class="career-growth__viewport">
      <div class="career-growth__track" data-growth-track>
        <!-- ===== Step 1：经营意识（宽幅棕卡） ===== -->
        <article class="gd-card gd-card--one">
          <p class="gd-kicker">经营意识</p>
          <p class="gd-desc gd-card--one__desc">
            从项目视角走到经营视角：理解企业怎么赚钱、怎么增长、怎么控成本，看见每一个管理动作背后的商业意义。
          </p>
          <span class="gd-ph gd-card--one__img" data-pstep="0.5" aria-hidden="true"></span>
          <div class="gd-card--one__foot">
            <h3 class="gd-h3">别只埋头干活，<br />抬头看看钱从哪来、往哪去。</h3>
            <span class="gd-step font-hand">Step 1</span>
          </div>
        </article>

        <!-- ===== Step 2：系统化管理（竖幅米卡 + 气泡涂鸦） ===== -->
        <article class="gd-card gd-card--two">
          <div class="gd-card--two__top">
            <span class="gd-step gd-step--dark font-hand">Step 2</span>
            <div class="gd-bubble" aria-hidden="true">
              <svg viewBox="0 0 110 64" fill="none">
                <path
                  d="M14 8 C 40 -2, 96 2, 103 22 C 108 40, 84 56, 48 55 C 38 55, 30 53, 22 50 L 6 60 L 12 44 C 4 36, 4 16, 14 8 Z"
                  stroke="currentColor"
                  stroke-width="2.4"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
              <span class="gd-hand">又双叒<br />起火了？</span>
            </div>
          </div>
          <p class="gd-note font-art">（先把灭火器放下…）</p>
          <h3 class="gd-h3 gd-h3--brown">救火英雄很酷，<br />但防火系统更酷。</h3>
        </article>

        <!-- ===== Step 3：产品与数字化（宽幅棕卡 + 溢出件） ===== -->
        <article class="gd-card gd-card--three">
          <span class="gd-polaroid gd-card--three__polaroid" data-pstep="0.35" aria-hidden="true">
            <span class="gd-polaroid__img"></span>
          </span>
          <span class="gd-ph-round gd-card--three__piece" aria-hidden="true"></span>
          <div class="gd-card--three__head">
            <h3 class="gd-h3">工具会过时，<br />判断力不会。</h3>
            <span class="gd-step font-hand">Step 3</span>
          </div>
          <p class="gd-desc gd-card--three__desc">
            不止会用工具，更要判断什么样的工具适合什么样的业务场景，让数字化和 AI 真正提升组织效率。
          </p>
        </article>

        <!-- ===== Step 4：团队管理与组织协同（中幅米卡） ===== -->
        <article class="gd-card gd-card--four">
          <span class="gd-ph-round gd-card--four__img" data-pstep="0.45" aria-hidden="true"></span>
          <div class="gd-card--four__foot">
            <h3 class="gd-h3 gd-h3--brown">
              一个人的优秀是及格线，<br />一群人的靠谱才是分数线。
            </h3>
            <span class="gd-step gd-step--dark font-hand">Step 4</span>
          </div>
        </article>

        <!-- ===== Step 5：财务、合规与风险（宽幅棕卡） ===== -->
        <article class="gd-card gd-card--five">
          <div class="gd-card--five__head">
            <h3 class="gd-h3">跑得快很重要，<br />刹车灵才敢加速。</h3>
            <span class="gd-step font-hand">Step 5</span>
          </div>
          <span class="gd-ph gd-card--five__img" data-pstep="0.4" aria-hidden="true"></span>
          <p class="gd-desc gd-card--five__desc">
            企业发展不能只看速度，也要看边界。成熟的管理者既要把业务做起来，也要让业务稳健、可持续地走下去。
          </p>
        </article>

        <!-- ===== 第六张：调侃总结卡（克莱因蓝） ===== -->
        <article class="gd-card gd-card--six">
          <h3 class="gd-h3">很简单。<br />不过是五个能力而已。</h3>
          <p class="gd-desc gd-card--six__desc">
            练完大概……只需要一整个职业生涯。
          </p>
          <span class="gd-polaroid gd-card--six__polaroid" data-pstep="0.3" aria-hidden="true">
            <span class="gd-polaroid__img gd-polaroid__img--blue"></span>
          </span>
        </article>
      </div>
    </div>
  </div>
</section>

<style>
  .career-growth {
    position: relative;
    background: var(--color-bg);
  }

  .career-growth__track {
    display: flex;
    align-items: center;
    gap: 20px;
    padding: 48px 24px;
  }

  /* ===== 卡片基础 ===== */
  .gd-card {
    position: relative;
    flex-shrink: 0;
    border-radius: 10px;
    overflow: visible;
  }

  .gd-kicker {
    font-size: 13px;
    letter-spacing: 0.24em;
    color: rgba(248, 241, 234, 0.78);
  }

  .gd-h3 {
    font-family: var(--font-serif);
    font-size: clamp(26px, 2.8vw, 40px);
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.01em;
    color: #f8f1ea;
  }

  .gd-h3--brown {
    color: var(--color-brown);
  }

  .gd-desc {
    font-size: 14px;
    line-height: 1.75;
  }

  .gd-step {
    font-size: clamp(28px, 2.6vw, 38px);
    line-height: 1;
    color: #f8f1ea;
    white-space: nowrap;
  }

  .gd-step--dark {
    color: var(--color-brown);
  }

  /* 手写注释（中文用楷体手写） */
  .gd-note {
    font-size: 16px;
    color: var(--color-brown);
  }

  .gd-hand {
    font-family: var(--font-art);
    font-size: 13px;
    line-height: 1.3;
    color: var(--color-ink);
  }

  /* 占位图：同色系深浅椭圆 / 圆件（后续可换真实图片） */
  .gd-ph {
    display: block;
    background: rgba(248, 241, 234, 0.22);
    border-radius: 50%;
  }

  .gd-ph-round {
    display: block;
    background: #cfc4ae;
    border-radius: 50%;
  }

  /* 拍立得占位：白框 + 渐变图 */
  .gd-polaroid {
    display: block;
    padding: 6px 6px 22px;
    background: #fffdf8;
    border-radius: 3px;
  }

  .gd-polaroid__img {
    display: block;
    width: 100%;
    height: calc(100% - 0px);
    aspect-ratio: 1;
    background: linear-gradient(140deg, #dfe3d5 0%, #c3ccb6 60%, #a9b598 100%);
    border-radius: 2px;
  }

  .gd-polaroid__img--blue {
    background: linear-gradient(135deg, #dce4f8 0%, #b9c8f2 55%, #8fa7e8 100%);
  }

  /* ===== Step 1：宽幅棕卡（图溢出下边缘） ===== */
  .gd-card--one {
    width: min(80vw, 1150px);
    height: min(56vh, 560px);
    background: var(--color-brown);
    padding: clamp(24px, 2.6vw, 40px);
    display: flex;
    flex-direction: column;
    overflow: hidden; /* 图向下溢出裁掉，保持贴边效果 */
  }

  .gd-card--one__desc {
    position: absolute;
    right: clamp(24px, 2.6vw, 40px);
    top: clamp(24px, 2.6vw, 40px);
    max-width: 300px;
    color: #f8f1ea;
  }

  .gd-card--one__img {
    position: absolute;
    left: 46%;
    top: 34%;
    width: clamp(160px, 16vw, 230px);
    aspect-ratio: 1 / 1.4;
    rotate: 22deg;
  }

  .gd-card--one__foot {
    margin-top: auto;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 32px;
  }

  /* ===== Step 2：竖幅米卡 ===== */
  .gd-card--two {
    width: min(46vw, 620px);
    height: min(64vh, 640px);
    background: #e5e1d6;
    padding: clamp(24px, 2.6vw, 40px);
    display: flex;
    flex-direction: column;
  }

  .gd-card--two__top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 24px;
  }

  .gd-bubble {
    position: relative;
    width: 110px;
    color: var(--color-blue);
  }

  .gd-bubble svg {
    display: block;
    width: 100%;
  }

  .gd-bubble .gd-hand {
    position: absolute;
    left: 22px;
    top: 14px;
  }

  .gd-card--two .gd-note {
    margin-top: auto;
    align-self: flex-end;
  }

  .gd-card--two .gd-h3--brown {
    margin-top: 10px;
  }

  /* ===== Step 3：宽幅棕卡（拍立得溢出上边缘、圆件溢出右边缘） ===== */
  .gd-card--three {
    width: min(72vw, 980px);
    height: min(52vh, 520px);
    background: var(--color-brown);
    padding: clamp(24px, 2.6vw, 40px);
    display: flex;
    flex-direction: column;
  }

  .gd-card--three__polaroid {
    position: absolute;
    left: 34%;
    top: -70px;
    width: clamp(120px, 11vw, 160px);
    rotate: -8deg;
  }

  .gd-card--three__piece {
    position: absolute;
    right: -44px;
    top: 52%;
    width: clamp(80px, 7vw, 110px);
    aspect-ratio: 1 / 0.8;
    border-radius: 46% 54% 50% 50% / 60% 55% 45% 40%;
    background: #5d3325;
  }

  .gd-card--three__head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 32px;
    max-width: 720px;
  }

  .gd-card--three__desc {
    margin-top: auto;
    max-width: 320px;
    color: rgba(248, 241, 234, 0.85);
  }

  /* ===== Step 4：中幅米卡（圆件溢出上边缘） ===== */
  .gd-card--four {
    width: min(54vw, 720px);
    height: min(48vh, 480px);
    background: #e5e1d6;
    padding: clamp(24px, 2.6vw, 40px);
    display: flex;
    flex-direction: column;
  }

  .gd-card--four__img {
    position: absolute;
    left: 50%;
    top: -56px;
    translate: -50%;
    width: clamp(110px, 10vw, 150px);
    aspect-ratio: 1;
  }

  .gd-card--four__foot {
    margin-top: auto;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
  }

  /* ===== Step 5：宽幅棕卡 ===== */
  .gd-card--five {
    width: min(68vw, 920px);
    height: min(58vh, 580px);
    background: var(--color-brown);
    padding: clamp(24px, 2.6vw, 40px);
    display: flex;
    flex-direction: column;
  }

  .gd-card--five__head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 32px;
  }

  .gd-card--five__img {
    position: absolute;
    left: 50%;
    top: 46%;
    translate: -50% -50%;
    width: clamp(130px, 12vw, 180px);
    aspect-ratio: 1.5 / 1;
    border-radius: 44% 56% 52% 48% / 55% 45% 60% 40%;
    rotate: -14deg;
  }

  .gd-card--five__desc {
    margin-top: auto;
    max-width: 360px;
    color: rgba(248, 241, 234, 0.85);
  }

  /* ===== 第六张：克莱因蓝调侃卡 ===== */
  .gd-card--six {
    width: min(60vw, 820px);
    height: min(56vh, 560px);
    background: var(--color-blue);
    padding: clamp(28px, 3vw, 48px);
    display: flex;
    flex-direction: column;
    color: #fff;
  }

  .gd-card--six .gd-h3 {
    color: #fff;
    max-width: 520px;
  }

  .gd-card--six__desc {
    margin-top: auto;
    max-width: 260px;
    color: rgba(255, 255, 255, 0.85);
  }

  .gd-card--six__polaroid {
    position: absolute;
    right: clamp(24px, 4vw, 64px);
    top: 50%;
    translate: 0 -46%;
    width: clamp(150px, 14vw, 210px);
    rotate: 9deg;
  }

  /* ===== 桌面端：sticky + 纵向滚动驱动横向推进（滚完才继续下滚） ===== */
  @media (min-width: 768px) {
    .career-growth {
      height: calc(100vh + var(--track-overflow, 3200px));
    }

    .career-growth__sticky {
      position: sticky;
      top: 0;
      height: 100vh;
      display: flex;
      flex-direction: column;
      justify-content: center;
      overflow: hidden;
    }

    .career-growth__track {
      padding: 90px 40px;
      will-change: transform;
    }
  }

  /* ===== 移动端：原生横向滚动 + snap ===== */
  @media (max-width: 767px) {
    .career-growth__viewport {
      overflow-x: auto;
      overflow-y: visible;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
    }

    .career-growth__track {
      padding: 90px 20px 60px;
    }

    .gd-card {
      scroll-snap-align: center;
    }

    .gd-card--one { width: 86vw; height: 420px; }
    .gd-card--two { width: 78vw; height: 440px; }
    .gd-card--three { width: 86vw; height: 420px; }
    .gd-card--four { width: 78vw; height: 400px; }
    .gd-card--five { width: 86vw; height: 430px; }
    .gd-card--six { width: 82vw; height: 420px; }

    .gd-card--six__polaroid {
      position: static;
      translate: none;
      margin-top: 16px;
      align-self: flex-end;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .career-growth {
      height: auto;
    }

    .career-growth__sticky {
      position: static;
      height: auto;
    }

    .career-growth__viewport {
      overflow-x: auto;
    }
  }
</style>

<script>
  // 桌面端：纵向滚动进度 → 轨道横向位移（scrub，滚完才释放页面继续下滚）
  // [data-pstep] 元素随进度做轻微横向 parallax（对照 Wildbran data-parallax-step）
  const section = document.querySelector<HTMLElement>("[data-growth]");
  const track = section?.querySelector<HTMLElement>("[data-growth-track]");
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const desktop = window.matchMedia("(min-width: 768px)");

  if (section && track && !reduce) {
    const psteps = [...track.querySelectorAll<HTMLElement>("[data-pstep]")];

    const measure = () => {
      if (!desktop.matches) {
        section.style.removeProperty("--track-overflow");
        track.style.transform = "";
        for (const el of psteps) el.style.translate = "";
        return;
      }
      const overflow = Math.max(track.scrollWidth - window.innerWidth, 0);
      section.style.setProperty("--track-overflow", `${overflow}px`);
    };

    let ticking = false;

    const update = () => {
      ticking = false;
      if (!desktop.matches) return;
      const rect = section.getBoundingClientRect();
      const vh = window.innerHeight;
      if (rect.bottom < 0 || rect.top > vh) return;
      const total = Math.max(rect.height - vh, 1);
      const p = Math.min(Math.max(-rect.top / total, 0), 1);
      const overflow = Math.max(track.scrollWidth - window.innerWidth, 0);
      track.style.transform = `translateX(${(-p * overflow).toFixed(1)}px)`;
      /* 图片轻微横向 parallax：与轨道反向缓动 */
      for (const el of psteps) {
        const f = parseFloat(el.dataset.pstep || "0");
        el.style.translate = `${((p - 0.5) * 120 * f).toFixed(1)}px 0`;
      }
    };

    measure();
    addEventListener("resize", () => {
      measure();
      update();
    });
    addEventListener(
      "scroll",
      () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(update);
        }
      },
      { passive: true }
    );
    update();
  }
</script>
