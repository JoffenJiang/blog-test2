---
/**
 * CareerPhotoScatter —— 照片散开（无文字、无阴影、无白框）
 *
 * 照片尺寸不一（方形 / 长方形混合）：使用 <img>，加载成功后高度随
 * 图片原始比例自适应；图片缺失时回退为渐变占位（占位比例见 --ar）。
 * 把真实照片放到 public/media/career-photo-01.jpg ~ 16.jpg 即可生效。
 *
 * 散开逻辑：初始堆叠成一垒，随滚动散开；散开目标位置每次刷新随机
 * （抖动网格采样，均匀铺满含中间区域，不留空洞），旋转角也随机。
 */

/** 每张照片：宽度 + 占位比例（真实图片就位后比例以图片为准） */
const photos = [
  { w: 200, ar: "1 / 1", ph: "warm" },
  { w: 150, ar: "3 / 4", ph: "sage" },
  { w: 230, ar: "4 / 3", ph: "blue" },
  { w: 130, ar: "1 / 1", ph: "rose" },
  { w: 180, ar: "4 / 5", ph: "sage" },
  { w: 240, ar: "3 / 2", ph: "warm" },
  { w: 140, ar: "1 / 1", ph: "blue" },
  { w: 210, ar: "4 / 3", ph: "rose" },
  { w: 160, ar: "3 / 4", ph: "warm" },
  { w: 250, ar: "16 / 10", ph: "sage" },
  { w: 135, ar: "1 / 1", ph: "rose" },
  { w: 190, ar: "4 / 5", ph: "blue" },
  { w: 220, ar: "4 / 3", ph: "sage" },
  { w: 145, ar: "3 / 4", ph: "warm" },
  { w: 175, ar: "1 / 1", ph: "blue" },
  { w: 205, ar: "3 / 2", ph: "rose" },
];

const gradients: Record<string, string> = {
  warm: "linear-gradient(135deg, #e8dccb 0%, #d9c9b2 55%, #c9b498 100%)",
  sage: "linear-gradient(140deg, #dfe3d5 0%, #c3ccb6 60%, #a9b598 100%)",
  blue: "linear-gradient(135deg, #dce4f8 0%, #b9c8f2 55%, #8fa7e8 100%)",
  rose: "linear-gradient(140deg, #f0dfd6 0%, #e3c4b4 60%, #d4a894 100%)",
};
---

<section class="career-photo-scatter" data-photo-scatter>
  <div class="career-photo-scatter__sticky">
    <div class="career-photo-stack" data-photo-stack>
      {
        photos.map((p, i) => (
          <figure
            class:list={["career-photo", i >= 8 && "career-photo--desktop"]}
            style={`--w:${p.w}px;--ar:${p.ar};--fallback:${gradients[p.ph]};--z:${i}`}
          >
            <img
              src={`/media/career-photo-${String(i + 1).padStart(2, "0")}.jpg`}
              alt=""
              loading="lazy"
              onerror="this.classList.add('is-missing')"
            />
          </figure>
        ))
      }
    </div>
  </div>
</section>

<style>
  /* 舞台：170vh 的滚动距离驱动散开进度 --p；margin-top 为进场前的留白页面 */
  .career-photo-scatter {
    position: relative;
    height: 170vh;
    margin-top: 30vh;
    background: var(--color-bg);
    overflow: clip;
  }

  .career-photo-scatter__sticky {
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100svh;
    overflow: hidden;
  }

  .career-photo-stack {
    position: absolute;
    inset: 0;
    pointer-events: none;
    --amp: 1;
  }

  /* 照片：无阴影、无白框，尺寸随图片自适应 */
  .career-photo {
    position: absolute;
    left: 50%;
    top: 50%;
    z-index: var(--z, 0);
    width: var(--w);
    margin: 0;
    transform: translate(
        calc(-50% + var(--dx, 0px) * var(--p, 0) * var(--amp)),
        calc(-50% + var(--dy, 0px) * var(--p, 0) * var(--amp))
      )
      rotate(calc(var(--r0, 0deg) + (var(--r, 0deg) - var(--r0, 0deg)) * var(--p, 0)));
    will-change: transform;
  }

  .career-photo img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 3px;
  }

  /* 图片缺失：隐藏 img，figure 退化为渐变占位（按 --ar 比例） */
  .career-photo img.is-missing {
    display: none;
  }

  .career-photo:has(img.is-missing) {
    aspect-ratio: var(--ar);
    background: var(--fallback);
    border-radius: 3px;
  }

  @media (max-width: 639px) {
    .career-photo-scatter {
      height: 150vh;
      margin-top: 20vh;
    }

    .career-photo--desktop {
      display: none;
    }

    .career-photo-stack {
      --amp: 0.55;
    }

    .career-photo {
      width: calc(var(--w) * 0.6);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .career-photo-stack {
      --p: 1;
    }
  }
</style>

<script>
  /**
   * 随机散开：每次加载用「打乱的抖动网格」生成目标位置——
   * 网格覆盖整个舞台（含中间），每张照片占一格再加随机抖动，
   * 保证均匀铺满、无空洞，且每次刷新布局不同。
   */
  const section = document.querySelector<HTMLElement>("[data-photo-scatter]");
  const stack = section?.querySelector<HTMLElement>("[data-photo-stack]");
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (section && stack) {
    const items = [...stack.querySelectorAll<HTMLElement>(".career-photo")];

    const assignTargets = () => {
      /* 只对可见照片布格（移动端后 8 张隐藏） */
      const visible = items.filter((el) => el.offsetParent !== null || getComputedStyle(el).display !== "none");
      const n = visible.length;
      /* 网格列数：尽量接近视口比例 */
      const cols = Math.ceil(Math.sqrt(n * (innerWidth / innerHeight)));
      const rows = Math.ceil(n / cols);
      /* 可散开范围（相对中心，vw/vh 半幅） */
      const rangeX = 44; /* vw */
      const rangeY = 38; /* vh */
      const cellW = (rangeX * 2) / cols;
      const cellH = (rangeY * 2) / rows;

      /* 打乱格子 */
      const cells = Array.from({ length: cols * rows }, (_, i) => i);
      for (let i = cells.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [cells[i], cells[j]] = [cells[j], cells[i]];
      }

      visible.forEach((el, i) => {
        const cell = cells[i];
        const cx = -rangeX + (cell % cols) * cellW + cellW / 2;
        const cy = -rangeY + Math.floor(cell / cols) * cellH + cellH / 2;
        /* 格内随机抖动（不超过半格，避免重叠成洞） */
        const jx = (Math.random() - 0.5) * cellW * 0.8;
        const jy = (Math.random() - 0.5) * cellH * 0.8;
        el.style.setProperty("--dx", `${(cx + jx).toFixed(1)}vw`);
        el.style.setProperty("--dy", `${(cy + jy).toFixed(1)}vh`);
        /* 初始 / 最终旋转角随机 */
        el.style.setProperty("--r0", `${((Math.random() - 0.5) * 10).toFixed(1)}deg`);
        el.style.setProperty("--r", `${((Math.random() - 0.5) * 50).toFixed(1)}deg`);
      });
    };

    assignTargets();

    if (!reduce) {
      let ticking = false;

      const update = () => {
        ticking = false;
        const rect = section.getBoundingClientRect();
        const vh = window.innerHeight;
        if (rect.bottom < 0 || rect.top > vh) return;
        const total = Math.max(rect.height - vh, 1);
        const p = Math.min(Math.max(-rect.top / total, 0), 1);
        stack.style.setProperty("--p", p.toFixed(3));
      };

      addEventListener(
        "scroll",
        () => {
          if (!ticking) {
            ticking = true;
            requestAnimationFrame(update);
          }
        },
        { passive: true }
      );
      update();
    }
  }
</script>
