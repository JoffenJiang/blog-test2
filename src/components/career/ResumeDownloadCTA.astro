---
/**
 * ResumeDownloadCTA —— 简历下载（页尾大标题 CTA）
 * 居中衬线超大标题 + 居中蓝色胶囊按钮，点击直接下载简历 PDF
 * 简历文件放在 public/files/蒋永芳-简历.pdf，替换文件即可更新
 */
import PillButton from "../PillButton.astro";
---

<section class="career-resume-cta">
  <div data-reveal class="career-resume-cta__inner">
    <h2 class="career-resume-cta__title font-serif">
      想更完整地<br class="md:hidden" />认识我吗？
    </h2>
    <div class="career-resume-cta__button">
      <PillButton href="/files/蒋永芳-简历.pdf" download>下载我的简历</PillButton>
    </div>
  </div>
</section>

<style>
  .career-resume-cta {
    background: var(--color-bg);
    padding: clamp(120px, 18vh, 220px) 24px;
  }

  .career-resume-cta__inner {
    max-width: 1100px;
    margin: 0 auto;
    text-align: center;
  }

  .career-resume-cta__title {
    font-size: clamp(44px, 6.5vw, 92px);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  .career-resume-cta__button {
    margin-top: clamp(36px, 6vh, 56px);
    display: flex;
    justify-content: center;
  }
</style>
