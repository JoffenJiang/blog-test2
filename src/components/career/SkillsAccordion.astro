---
/**
 * SkillsAccordion —— 专业技能（紧凑手风琴）
 * 左侧衬线超大「专业技能」标题（桌面端吸顶）
 * 右侧两条手风琴：条目标题 15px 不加粗；能力名 13px、描述 10px 不加粗，间距紧凑
 * 蓝色圆球 15px，符号为向下 chevron
 * 互斥展开：点开一条时自动收起另一条
 * hover 行：文字与圆球向内缩小、球内符号翻转，移开复原
 */
import { skillGroups } from "../../data/career";
---

<section class="career-faqs" data-skills>
  <div class="career-faqs__inner">
    <h2 data-reveal class="career-faqs__title font-serif">专业技能</h2>

    <div class="career-faqs__list">
      {
        skillGroups.map((group, i) => (
          <div class="career-faq">
            <button
              type="button"
              class="career-faq__trigger"
              aria-expanded="false"
              aria-controls={`faq-panel-${i}`}
            >
              <span class="career-faq__label">{group.title}</span>
              <span class="career-faq__button" aria-hidden="true">
                <svg viewBox="0 0 12 8" fill="none">
                  <path
                    d="M1.5 1.75 6 6.25l4.5-4.5"
                    stroke="currentColor"
                    stroke-width="1.6"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </span>
            </button>
            <div class="career-faq__content" id={`faq-panel-${i}`} role="region">
              <div class="career-faq__content-inner">
                <dl class="career-faq__points">
                  {group.items.map((item) => (
                    <div class="career-faq__point">
                      <dt>{item.name}</dt>
                      <dd>{item.desc}</dd>
                    </div>
                  ))}
                </dl>
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .career-faqs {
    background: var(--color-bg);
    padding: clamp(96px, 14vh, 180px) 24px;
  }

  .career-faqs__inner {
    max-width: 1400px;
    margin: 0 auto;
    display: grid;
    gap: 48px;
  }

  @media (min-width: 900px) {
    .career-faqs__inner {
      grid-template-columns: 1fr 1.15fr;
      gap: 64px;
      align-items: start;
    }

    .career-faqs__title {
      position: sticky;
      top: 120px;
    }
  }

  /* 衬线超大标题 */
  .career-faqs__title {
    font-size: clamp(56px, 7vw, 100px);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1;
  }

  /* ===== 手风琴条目 ===== */
  .career-faq {
    border-bottom: 1px solid var(--color-border);
  }

  .career-faq__trigger {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 18px 0;
    text-align: left;
    cursor: pointer;
  }

  /* 条目标题：15px 不加粗；hover 向内缩（origin 左侧） */
  .career-faq__label {
    font-size: 15px;
    font-weight: 400;
    letter-spacing: 0.01em;
    transform-origin: left center;
    transition: transform 0.3s ease;
  }

  /* 蓝色圆球：15px；hover 缩小、符号翻转 */
  .career-faq__button {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 15px;
    height: 15px;
    border-radius: 50%;
    background: var(--color-blue);
    color: #fff;
    transition: transform 0.3s ease;
  }

  .career-faq__button svg {
    width: 7px;
    height: 5px;
    transition: transform 0.3s ease;
  }

  /* hover：文字向内缩、圆球向内缩小且符号翻转；移开复原 */
  .career-faq__trigger:hover .career-faq__label {
    transform: scale(0.94);
  }

  .career-faq__trigger:hover .career-faq__button {
    transform: scale(0.8);
  }

  .career-faq__trigger:hover .career-faq__button svg {
    transform: rotate(180deg);
  }

  /* 展开状态：符号朝上 */
  .career-faq.is-open .career-faq__button svg {
    transform: rotate(180deg);
  }

  .career-faq.is-open .career-faq__trigger:hover .career-faq__button svg {
    transform: rotate(0deg);
  }

  /* ===== 展开内容：grid-rows 过渡 + 淡入 ===== */
  .career-faq__content {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.45s ease;
  }

  .career-faq__content-inner {
    overflow: hidden;
    opacity: 0;
    transition: opacity 0.4s ease;
  }

  .career-faq.is-open .career-faq__content {
    grid-template-rows: 1fr;
  }

  .career-faq.is-open .career-faq__content-inner {
    opacity: 1;
    transition-delay: 0.15s;
  }

  /* 分点排版：紧凑（能力名 13px / 描述 10px，均不加粗） */
  .career-faq__points {
    padding: 2px 0 20px;
  }

  .career-faq__point + .career-faq__point {
    margin-top: 10px;
  }

  .career-faq__point dt {
    font-size: 13px;
    font-weight: 400;
  }

  .career-faq__point dd {
    margin-top: 2px;
    font-size: 10px;
    line-height: 1.7;
    font-weight: 400;
    color: rgba(36, 36, 36, 0.7);
    max-width: 560px;
  }

  @media (prefers-reduced-motion: reduce) {
    .career-faq__content,
    .career-faq__content-inner,
    .career-faq__button,
    .career-faq__button svg,
    .career-faq__label {
      transition: none;
    }
  }
</style>

<script>
  // 互斥手风琴：展开一条时收起其余
  const groups = [...document.querySelectorAll<HTMLElement>("[data-skills] .career-faq")];

  for (const group of groups) {
    const trigger = group.querySelector<HTMLButtonElement>(".career-faq__trigger");
    trigger?.addEventListener("click", () => {
      const willOpen = !group.classList.contains("is-open");
      for (const g of groups) {
        const open = g === group && willOpen;
        g.classList.toggle("is-open", open);
        g.querySelector(".career-faq__trigger")?.setAttribute("aria-expanded", String(open));
      }
    });
  }
</script>
