---
/**
 * Header —— 轻盈吸顶导航（参考 WildBran）
 * 无底部分割线、无阴影
 * 桌面端 hover / focus 时才出现随机手绘短线；当前页只用字重 + 颜色表示
 * 移动端折叠菜单，不显示线条
 */
import { navItems } from "../data/navigation";

const normalize = (p: string) =>
  p !== "/" && p.endsWith("/") ? p.slice(0, -1) : p;
const current = normalize(Astro.url.pathname);

const isActive = (href: string) =>
  href === "/" ? current === "/" : current === href || current.startsWith(`${href}/`);
---

<header class="sticky top-0 z-50 bg-bg/85 backdrop-blur-md">
  <div class="mx-auto flex h-16 max-w-[1200px] items-center justify-between px-5 md:px-8">
    <a href="/" class="text-[17px] font-semibold tracking-wide">蒋永芳</a>

    <nav class="hidden md:block" aria-label="主导航">
      <ul class="flex items-center gap-7">
        {
          navItems.map((item) => {
            const active = isActive(item.href);
            return (
              <li>
                <a
                  href={item.href}
                  aria-current={active ? "page" : undefined}
                  class:list={[
                    "nav-link relative py-2 text-[15px] transition-colors",
                    active
                      ? "font-semibold text-ink"
                      : "text-ink/60 hover:text-ink",
                  ]}
                >
                  {item.label}
                  {!active && (
                    <svg
                      class="nav-scribble"
                      viewBox="0 0 64 10"
                      preserveAspectRatio="none"
                      fill="none"
                      aria-hidden="true"
                    >
                      <path
                        d="M2 6 C 12 3, 24 8, 36 5 S 56 6, 62 4.5"
                        pathLength="1"
                        stroke-width="2"
                        vector-effect="non-scaling-stroke"
                      />
                    </svg>
                  )}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>

    <button
      id="nav-toggle"
      type="button"
      class="-mr-2 flex h-10 w-10 items-center justify-center md:hidden"
      aria-expanded="false"
      aria-controls="mobile-nav"
      aria-label="打开菜单"
    >
      <svg class="h-4 w-5" viewBox="0 0 20 14" fill="none" aria-hidden="true">
        <path d="M1 2h18" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
        <path d="M1 12h18" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
      </svg>
    </button>
  </div>

  <nav id="mobile-nav" class="hidden bg-bg/95 backdrop-blur-md md:hidden" aria-label="移动端导航">
    <ul class="px-5 pb-4 pt-1">
      {
        navItems.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={isActive(item.href) ? "page" : undefined}
              class:list={[
                "block rounded-md px-3 py-3 text-[16px] transition-colors hover:bg-card-alt",
                isActive(item.href) ? "font-semibold text-ink" : "text-ink/70",
              ]}
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<script>
  // 移动端菜单开合
  const toggle = document.getElementById("nav-toggle");
  const panel = document.getElementById("mobile-nav");

  toggle?.addEventListener("click", () => {
    const open = panel ? !panel.classList.toggle("hidden") : false;
    toggle.setAttribute("aria-expanded", String(open));
    toggle.setAttribute("aria-label", open ? "关闭菜单" : "打开菜单");
  });

  // 导航 hover 手绘线：每次 hover / focus 随机换一种曲线形态
  const scribblePaths = [
    "M2 6 C 12 3, 24 8, 36 5 S 56 6, 62 4.5",
    "M3 5 C 16 8.5, 28 2, 42 6.5 S 58 3.5, 61 5.5",
    "M2 4.5 C 10 7.5, 26 2.5, 40 7 S 57 4, 62 6.5",
  ];

  document.querySelectorAll<SVGPathElement>(".nav-scribble path").forEach((path) => {
    const link = path.closest("a");
    const shuffle = () => {
      path.setAttribute(
        "d",
        scribblePaths[Math.floor(Math.random() * scribblePaths.length)]
      );
    };
    link?.addEventListener("mouseenter", shuffle);
    link?.addEventListener("focus", shuffle);
  });
</script>
