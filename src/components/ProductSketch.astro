      <circle cx="96" cy="128" r="26" fill="#c9803c" />
      <circle cx="88" cy="120" r="3.5" fill="#7a4a21" />
      <circle cx="104" cy="132" r="3.5" fill="#7a4a21" />
      <circle cx="94" cy="142" r="3" fill="#7a4a21" />
      <circle cx="106" cy="116" r="3" fill="#7a4a21" />
      <path d="M56 178 q12 -12 22 2 q-12 10 -22 -2Z" fill="#e08a3c" />
      <path d="M112 184 q14 -10 24 4 q-14 10 -24 -4Z" fill="#e08a3c" />
      <rect x="42" y="196" width="118" height="22" rx="6" fill="#e08a3c" />
    </svg>
  )
}

{
  variant === "bars" && (
    <svg class={className} viewBox="0 0 190 240" fill="none" aria-hidden="true">
      <ellipse cx="97" cy="230" rx="70" ry="8" fill="rgba(31,31,31,0.10)" />
      <path d="M24 42 L48 28 L48 214 L24 224 Z" fill="#b79cd1" />
      <rect x="48" y="28" width="118" height="188" rx="6" fill="#ddc7ec" />
      <rect x="62" y="96" width="90" height="34" rx="9" fill="#6b4326" transform="rotate(-8 107 113)" />
      <path d="M74 100 h60" stroke="#8f5a2b" stroke-width="3" stroke-linecap="round" transform="rotate(-8 107 113)" />
      <rect x="66" y="140" width="82" height="30" rx="8" fill="#7a4a21" transform="rotate(6 107 155)" />
      <path d="M60 56 q12 -12 22 2 q-12 10 -22 -2Z" fill="#a980c9" />
