      <path d="M116 150 q10 -14 20 0 q-10 12 -20 0Z" fill="#cf4a35" />
      <path d="M60 186 q12 -12 22 2 q-12 10 -22 -2Z" fill="#cf4a35" />
      <circle cx="100" cy="106" r="4" fill="#8f2f22" />
      <circle cx="84" cy="160" r="4" fill="#8f2f22" />
      <circle cx="132" cy="120" r="4" fill="#8f2f22" />
      <rect x="42" y="196" width="118" height="22" rx="6" fill="#cf4a35" />
    </svg>
  )
}

{
  variant === "cookies" && (
    <svg class={className} viewBox="0 0 180 245" fill="none" aria-hidden="true">
      <ellipse cx="92" cy="234" rx="66" ry="8" fill="rgba(31,31,31,0.10)" />
      <path d="M20 44 L42 30 L42 216 L20 226 Z" fill="#b56224" />
