---
/**
 * Button —— 干净的块状按钮，无线条装饰
 * variant: solid 实心（主行动） / outline 描边（次行动）
 */
interface Props {
  href: string;
  variant?: "solid" | "outline";
  class?: string;
}

const { href, variant = "outline", class: className = "" } = Astro.props;

const base =
  "inline-flex items-center justify-center rounded-md px-6 py-2.5 text-[15px] font-medium transition-all duration-200 hover:-translate-y-0.5";

const styles =
  variant === "solid"
    ? "bg-ink text-bg hover:bg-ink/90"
    : "border border-border bg-card text-ink hover:border-ink/40";
---

<a href={href} class:list={[base, styles, className]}>
  <slot />
</a>
