    opacity: 0;
    transform: translateY(24px);
    transition:
      opacity 0.7s ease,
      transform 0.7s ease;
  }

  .mood-sub {
    transition-delay: 0.1s;
  }

  .mood-btn {
    transition-delay: 0.2s;
