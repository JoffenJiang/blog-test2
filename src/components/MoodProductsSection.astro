  }

  /* ===== 产品图层与形状占位符 ===== */
  .mood-product-img {
    width: 100%;
  }

  .mood-shape {
    width: 100%;
  }

  .mood-img {
    display: block;
    width: 100%;
    height: auto;
  }

  /* 日常杂记：调色盘 / 职业ootd：笔记本 / 汉服ootd：相机 SVG（宽度随组，高度按 viewBox 等比） */
  .mood-palette,
  .mood-laptop,
  .mood-camera {
    display: block;
    width: 100%;
    height: auto;
  }

  /* 包装袋：圆角矩形 + 顶部封口 */
  .mood-shape-bag {
    aspect-ratio: 4 / 5;
    background: #e6cf9d;
    border-radius: 14% / 11%;
    position: relative;
  }

  .mood-shape-bag::before {
    content: "";
    position: absolute;
    left: 4%;
    right: 4%;
    top: 0;
    height: 9%;
    background: #d0b276;
    border-radius: 999px;
  }

  .mood-shape-bag--green {
    background: #ccd6ad;
  }

  .mood-shape-bag--green::before {
    background: #aebb85;
  }

  /* 盒子：圆角矩形 + 左侧深色棱面（轻微 3D 感） */
  .mood-shape-box {
    aspect-ratio: 3 / 4;
    background: #f1e6cf;
    border-radius: 6% / 4.5%;
    position: relative;
  }

  .mood-shape-box::before {
    content: "";
    position: absolute;
    left: 0;
    top: 2%;
    bottom: 2%;
    width: 11%;
    border-radius: 6px 0 0 6px;
    transform: skewY(-4deg);
  }

  .mood-shape-box--red::before {
    background: #bc4a35;
  }

  .mood-shape-box--orange {
