  /* 环游记（burst）组整体下移一档，贴近底排（对照 Wildbran） */
  .mood-product--burst        { left: 46%;  bottom: clamp(56px, 7svh, 110px); width: clamp(120px, 11vw, 170px); }
  .mood-product--bars         { right: 10%; bottom: var(--mood-bottom-safe); width: clamp(220px, 20vw, 320px); }
  .mood-product--bottom-blur  { right: 25%; bottom: clamp(80px, 10svh, 160px); width: 62px; }

