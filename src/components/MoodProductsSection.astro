    .mood-product--top-blur     { width: 52px; }
    .mood-product--energy-ball  { width: 72px; }
    .mood-product--crackers     { width: 150px; }
    .mood-product--left-bar     { width: 120px; }
    .mood-product--right-cracker{ width: 62px; }
    .mood-product--cookies      { width: clamp(150px, 18vw, 290px); }
    .mood-product--burst        { width: clamp(96px, 11vw, 170px); }
    .mood-product--bars         { width: clamp(160px, 20vw, 320px); }
