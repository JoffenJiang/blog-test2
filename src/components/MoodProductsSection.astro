---
/**
 * MoodProductsSection —— 高保真参考 Wildbran "What are you in the mood for?"
 *
 * 结构模型（视觉舞台 + 底部退场空间，不是 100vh 裁切画布）：
 *   section.mood-products-section        整个区块，min-height = 100svh + 米白退场空间
 *     div.mood-products-canvas           产品视觉舞台（同高，横向裁切、纵向完整）
 *       div.mood-center                  标题 + 按钮，居中在首屏 100svh 内
 *       figure.mood-product--xxx         产品视觉组（绝对定位）
 *         div.mood-product-composite     组内复合层：产品图 + callout，overflow visible
 *           div.mood-product-img         产品图层（占位形状 / 未来的真实 img）
 *           figcaption.mood-product-callout   箭头 + 手写文字
 *   底部三组产品用 --mood-bottom-safe 抬离底边，callout 落在组的 padding-bottom 区内，
 *   保证在进入下一个暗色板块前完整可见；下一板块正常衔接，不覆盖本区。
 *
 * 动效：标题/按钮先淡入 → 随滚动分三批出现（顶部排 → 两侧小件 → 底部排）→
 *       顶部/装饰元素随滚动做 10–30px 轻微 parallax；
 *       prefers-reduced-motion 时全部直接显示。
 *
 * ★ 替换真实图片：把 .mood-product-img 里的 <div class="mood-shape ..."> 换成
 *   <img class="mood-img" src="/media/products/xxx.png" alt="" /> 即可，
 *   组的位置 / 尺寸 / 旋转 / 动效不用改。
 */
import PillButton from "./PillButton.astro";

interface Layer {
  /** 组名：定位 class 为 .mood-product--{key} */
  key: string;
  /** 占位符形状 class */
  shape: string;
  /** 出现批次：1 顶部排 / 2 两侧小件 / 3 底部排 */
  batch: 1 | 2 | 3;
  /** 批内错开延迟 */
  stagger: string;
  /** 滑入起点与最终旋转角 */
  vars: string;
  /** parallax 强度（顶部/装饰元素） */
  parallax?: number;
  /** 手写标签（仅 5 个产品有） */
  label?: string;
  /** 箭头形态（对照原站：绕圈 / 闪电 / 左弓上扬 / 下弯 / 回勾） */
  labelArrow?: keyof typeof arrows;
  /** callout 排列：箭头在前 / 文字在前 / 箭头在文字上方 */
  labelLayout?: "arrow-text" | "text-arrow" | "arrow-over-text";
}

/** 蓝色手绘箭头（五种形态，均从图片向外画、头指向文字） */
const arrows = {
  loop:   { vb: "0 0 36 20", line: "M2 13 C 3 5, 12 4, 12 10 C 12 16, 4 16, 5 10 C 6 3, 18 4, 30 8", head: "M26 4.5 30.5 8 25 10.5" },
  zigzag: { vb: "0 0 30 22", line: "M4 3 Q 12 4 15 7 Q 7 8 6 11 Q 13 14 18 15", head: "M13.5 11 19 15.5 12.5 17.5" },
  rise:   { vb: "0 0 26 26", line: "M14 24 C 4 19, 4 8, 13 3", head: "M6.5 4.5 13.5 2.5 11 9.5" },
  curl:   { vb: "0 0 20 26", line: "M17 3 C 9 5, 9 14, 6 22", head: "M3.5 16.5 6 22.5 12.5 21" },
  hook:   { vb: "0 0 24 26", line: "M18 2 C 22 9, 20 16, 10 21", head: "M15.5 16.5 9.5 21.5 16 24.5" },
};

const layers: Layer[] = [
  { key: "bites", shape: "mood-shape-bag", batch: 1, stagger: "0s", vars: "--sy:-80px;--rot:-6deg", parallax: 0.035, label: "日常杂记", labelArrow: "loop", labelLayout: "arrow-text" },
  { key: "top-blur", shape: "mood-shape-blur", batch: 1, stagger: ".1s", vars: "--sy:-60px;--op:.45", parallax: 0.06 },
  { key: "energy-ball", shape: "mood-shape-ball", batch: 1, stagger: ".2s", vars: "--sy:-70px", parallax: 0.05 },
  { key: "crackers", shape: "mood-shape-box mood-shape-box--red", batch: 1, stagger: ".3s", vars: "--sy:-80px;--rot:5deg", parallax: 0.04, label: "职业ootd", labelArrow: "zigzag", labelLayout: "arrow-text" },
  { key: "left-bar", shape: "mood-shape-bar", batch: 2, stagger: "0s", vars: "--sx:-70px;--rot:-8deg", parallax: 0.055 },
  { key: "right-cracker", shape: "mood-shape-piece", batch: 2, stagger: ".12s", vars: "--sx:70px;--rot:14deg", parallax: 0.065 },
  { key: "cookies", shape: "mood-shape-box mood-shape-box--orange", batch: 3, stagger: "0s", vars: "--sy:80px;--rot:5deg", label: "汉服ootd", labelArrow: "curl", labelLayout: "arrow-over-text" },
  { key: "burst", shape: "mood-shape-bag mood-shape-bag--green", batch: 3, stagger: ".1s", vars: "--sy:80px;--rot:3deg", label: "环游记", labelArrow: "rise", labelLayout: "arrow-text" },
  { key: "bars", shape: "mood-shape-box mood-shape-box--purple", batch: 3, stagger: ".2s", vars: "--sy:80px;--rot:4deg", label: "梦到什么发什么系列", labelArrow: "hook", labelLayout: "text-arrow" },
  { key: "bottom-blur", shape: "mood-shape-blur", batch: 3, stagger: ".3s", vars: "--sy:60px;--op:.45", parallax: 0.06 },
];
---

<section
  data-mood-section
  class="mood-products-section"
  aria-label="时光日札"
>
  <div class="mood-products-canvas">
    <!-- 视觉中心：标题 + 按钮（居中在首屏 100svh 内） -->
    <div class="mood-center">
      <h2 class="mood-title font-serif font-bold">时光日札</h2>
      <p class="mood-sub">收集我的日常，工作、拍照、汉服、旅行和美食都有一点。</p>
      <div class="mood-btn mt-8">
        <PillButton href="/notes" label="来看看吧" />
      </div>
    </div>

    <!-- 10 个产品视觉组（椭圆环绕，图 + 箭头 + 文字为一个整体） -->
    {
      layers.map((l) => (
        <figure
          class:list={["mood-product", `mood-product--${l.key}`, `is--${l.key}`]}
          data-batch={l.batch}
          data-parallax={l.parallax}
          style={`${l.vars};--stg:${l.stagger}`}
        >
          <div class="mood-product-composite">
            <div class="mood-product-img">
              <div class:list={["mood-shape", l.shape]} />
            </div>
            {l.label && l.labelArrow && (
              <figcaption
                class:list={[
                  "mood-product-callout",
                  l.labelLayout === "arrow-over-text" && "mood-product-callout--column",
                ]}
              >
                {l.labelLayout !== "text-arrow" && (
                  <svg
                    class="mood-product-arrow"
                    viewBox={arrows[l.labelArrow].vb}
                    fill="none"
                    aria-hidden="true"
                  >
                    <path d={arrows[l.labelArrow].line} />
                    <path d={arrows[l.labelArrow].head} />
                  </svg>
                )}
                <span class="mood-product-label">{l.label}</span>
                {l.labelLayout === "text-arrow" && (
                  <svg
                    class="mood-product-arrow"
                    viewBox={arrows[l.labelArrow].vb}
                    fill="none"
                    aria-hidden="true"
                  >
                    <path d={arrows[l.labelArrow].line} />
                    <path d={arrows[l.labelArrow].head} />
                  </svg>
                )}
              </figcaption>
            )}
          </div>
        </figure>
      ))
    }
  </div>
</section>

<style>
  /* ===== 骨架：视觉舞台 + 底部米白退场空间 =====
   * min-height = 100svh（主要视觉舞台）+ clamp(...)（Wildbran 式退场空间）
   * 下一个暗色板块在退场空间之后正常衔接，不覆盖本区 */
  .mood-products-section {
    --mood-exit-buffer: clamp(140px, 16svh, 240px);
    --mood-bottom-safe: clamp(120px, 15svh, 220px);
    position: relative;
    z-index: 1;
    background: var(--color-bg);
    min-height: calc(100svh + var(--mood-exit-buffer));
    /* 与上一板块（视频首屏）保留的距离 = 底部退场留白，与下方职业发展板块的间距一致 */
    margin-top: var(--mood-exit-buffer);
    overflow-x: clip;
    overflow-y: visible;
  }

  .mood-products-canvas {
    position: relative;
    min-height: calc(100svh + var(--mood-exit-buffer));
    background: var(--color-bg);
    /* 只裁横向（收住 left-bar / right-cracker 的两侧溢出），
     * 纵向放开：避免顶部装饰（top-blur / energy-ball）在 canvas 上边缘
     * 被 overflow:hidden 削出一条突兀的硬直线 */
    overflow-x: clip;
    overflow-y: visible;
    display: flex;
    align-items: flex-start;
    justify-content: center;
  }

  /* ===== 中间标题：居中在首屏 100svh 内 ===== */
  .mood-center {
    position: relative;
    z-index: 10;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
  }

  /* 标题字号统一约 36px（移动端略小） */
  .mood-title {
    max-width: 620px;
    font-size: 30px;
    line-height: 1.2;
  }

  @media (min-width: 640px) {
    .mood-title {
      font-size: 36px;
    }
  }

  /* 标题下副文案：15px 说明句 */
  .mood-sub {
    margin-top: 14px;
    max-width: 520px;
    font-size: 15px;
    line-height: 1.9;
    color: rgba(36, 36, 36, 0.65);
  }

  /* 标题 / 副文案 / 按钮进场 */
  .mood-title,
  .mood-sub,
  .mood-btn {
    opacity: 0;
    transform: translateY(24px);
    transition:
      opacity 0.7s ease,
      transform 0.7s ease;
  }

  .mood-sub {
    transition-delay: 0.1s;
  }

  .mood-btn {
    transition-delay: 0.2s;
  }

  .mood-head-in .mood-title,
  .mood-head-in .mood-sub,
  .mood-head-in .mood-btn {
    opacity: 1;
    transform: none;
  }

  /* ===== 产品视觉组：初始隐藏，按批次出现（动画只作用在组整体上） ===== */
  .mood-product {
    position: absolute;
    margin: 0;
    opacity: 0;
    transform: translate(var(--sx, 0px), var(--sy, 0px)) scale(0.88)
      rotate(calc(var(--rot, 0deg) + 5deg));
    transition:
      opacity 0.85s ease var(--stg, 0s),
      transform 0.85s cubic-bezier(0.25, 0.7, 0.3, 1) var(--stg, 0s);
    will-change: transform;
    pointer-events: none;
  }

  .mood-b1 .mood-product[data-batch="1"],
  .mood-b2 .mood-product[data-batch="2"],
  .mood-b3 .mood-product[data-batch="3"] {
    opacity: var(--op, 1);
    transform: translate(0, 0) scale(1) rotate(var(--rot, 0deg));
  }

  /* 组内复合层：产品图 + callout，一个整体，不裁切 callout */
  .mood-product-composite {
    position: relative;
    width: 100%;
    overflow: visible;
  }

  /* 底部三组：给 callout 预留 padding-bottom，callout 不超出组的盒子 */
  .mood-product--cookies .mood-product-composite,
  .mood-product--burst .mood-product-composite,
  .mood-product--bars .mood-product-composite {
    padding-bottom: 64px;
  }

  /* ===== 各组位置与尺寸 =====
   * 顶部 / 两侧：围绕标题的椭圆环
   * 底部三组：用 --mood-bottom-safe 抬离 section 底边，完整露出 */
  .mood-product--bites        { left: 5%;   top: 4%;   width: 210px; }
  .mood-product--top-blur     { left: 24%;  top: -1%;  width: 68px; }
  .mood-product--energy-ball  { left: 46%;  top: 2.5%; width: 96px; }
  .mood-product--crackers     { right: 7%;  top: 3.5%; width: 210px; }
  .mood-product--left-bar     { left: -4%;  top: 38%;  width: 170px; }
  .mood-product--right-cracker{ right: -1%; top: 36%;  width: 84px; }
  .mood-product--cookies      { left: 13%;  bottom: var(--mood-bottom-safe); width: clamp(210px, 18vw, 290px); }
  /* 环游记（burst）组整体下移一档，贴近底排（对照 Wildbran） */
  .mood-product--burst        { left: 46%;  bottom: clamp(56px, 7svh, 110px); width: clamp(120px, 11vw, 170px); }
  .mood-product--bars         { right: 10%; bottom: var(--mood-bottom-safe); width: clamp(220px, 20vw, 320px); }
  .mood-product--bottom-blur  { right: 25%; bottom: clamp(80px, 10svh, 160px); width: 62px; }

  @media (max-width: 1023px) {
    .mood-product--bites        { width: 150px; }
    .mood-product--top-blur     { width: 52px; }
    .mood-product--energy-ball  { width: 72px; }
    .mood-product--crackers     { width: 150px; }
    .mood-product--left-bar     { width: 120px; }
    .mood-product--right-cracker{ width: 62px; }
    .mood-product--cookies      { width: clamp(150px, 18vw, 290px); }
    .mood-product--burst        { width: clamp(96px, 11vw, 170px); }
    .mood-product--bars         { width: clamp(160px, 20vw, 320px); }
    .mood-product--bottom-blur  { width: 48px; }
  }

  @media (max-width: 639px) {
    .mood-product--bites        { width: 104px; left: 2%; }
    .mood-product--top-blur     { width: 40px; }
    .mood-product--energy-ball  { width: 54px; }
    .mood-product--crackers     { width: 104px; right: 2%; }
    .mood-product--left-bar,
    .mood-product--right-cracker { display: none; }
    .mood-product--cookies      { width: 116px; left: 6%; }
    .mood-product--burst        { width: 78px; left: 45%; }
    .mood-product--bars         { width: 126px; right: 5%; }
    .mood-product--bottom-blur  { width: 36px; }
  }

  /* ===== 产品图层与形状占位符 ===== */
  .mood-product-img {
    width: 100%;
  }

  .mood-shape {
    width: 100%;
  }

  .mood-img {
    display: block;
    width: 100%;
    height: auto;
  }

  /* 包装袋：圆角矩形 + 顶部封口 */
  .mood-shape-bag {
    aspect-ratio: 4 / 5;
    background: #e6cf9d;
    border-radius: 14% / 11%;
    position: relative;
  }

  .mood-shape-bag::before {
    content: "";
    position: absolute;
    left: 4%;
    right: 4%;
    top: 0;
    height: 9%;
    background: #d0b276;
    border-radius: 999px;
  }

  .mood-shape-bag--green {
    background: #ccd6ad;
  }

  .mood-shape-bag--green::before {
    background: #aebb85;
  }

  /* 盒子：圆角矩形 + 左侧深色棱面（轻微 3D 感） */
  .mood-shape-box {
    aspect-ratio: 3 / 4;
    background: #f1e6cf;
    border-radius: 6% / 4.5%;
    position: relative;
  }

  .mood-shape-box::before {
    content: "";
    position: absolute;
    left: 0;
    top: 2%;
    bottom: 2%;
    width: 11%;
    border-radius: 6px 0 0 6px;
    transform: skewY(-4deg);
  }

  .mood-shape-box--red::before {
    background: #bc4a35;
  }

  .mood-shape-box--orange {
    background: #f4ead6;
  }

  .mood-shape-box--orange::before {
    background: #cc8544;
  }

  .mood-shape-box--purple {
    aspect-ratio: 1;
    background: #e7dbf0;
  }

  .mood-shape-box--purple::before {
    background: #a687c6;
  }

  /* 圆形食物 */
  .mood-shape-ball {
    aspect-ratio: 1;
    background: #a2734a;
    border-radius: 50%;
  }

  /* 横向食物块（巧克力 bar）：不规则圆角 */
  .mood-shape-bar {
    aspect-ratio: 2.4 / 1;
    background: #6f4a2a;
    border-radius: 44% 56% 52% 48% / 55% 45% 60% 40%;
  }

  /* 小饼干块：不规则圆角小方块 */
  .mood-shape-piece {
    aspect-ratio: 1 / 0.9;
    background: #d9b98c;
    border-radius: 38% 62% 55% 45% / 48% 52% 45% 55%;
  }

  /* 灰色模糊圆形装饰 */
  .mood-shape-blur {
    aspect-ratio: 1;
    background: #b3afa6;
    border-radius: 50%;
    filter: blur(6px);
  }

  /* ===== callout：蓝色手绘箭头 + 黑色手写文字，绑定在组内 ===== */
  .mood-product-callout {
    position: absolute;
    display: flex;
    align-items: center;
    gap: 7px;
    white-space: nowrap;
    margin: 0;
  }

  .mood-product-callout--column {
    flex-direction: column;
    align-items: flex-start;
    gap: 3px;
  }

  /* 中文标签使用中文手写体（font-art：马善政楷体系） */
  .mood-product-label {
    font-family: var(--font-art);
    font-size: 20px;
    line-height: 1;
    color: var(--color-ink);
  }

  .mood-product-arrow {
    display: block;
    width: 32px;
    height: auto;
    flex-shrink: 0;
    color: var(--color-blue);
  }

  .mood-product-arrow path {
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  @media (max-width: 1023px) {
    .mood-product-label {
      font-size: 18px;
    }

    .mood-product-arrow {
      width: 26px;
    }
  }

  /* 各组 callout 位置：贴近产品图但不接触；
   * 底部三组的 callout 落在 composite 的 padding-bottom 区内，不会被裁切 */
  .is--bites .mood-product-callout    { right: -42%; top: 62%; }
  .is--crackers .mood-product-callout { left: 14%; bottom: -42px; }
  .is--cookies .mood-product-callout  { left: -12%; bottom: 2px; }
  .is--burst .mood-product-callout    { left: -8%; top: -50px; }
  .is--bars .mood-product-callout     { right: -4%; bottom: 14px; }

  @media (max-width: 639px) {
    .is--crackers .mood-product-callout { left: 0; bottom: -36px; }
    .is--cookies .mood-product-callout  { left: -14%; bottom: 0; }
    .is--bars .mood-product-callout     { right: 4%; bottom: 8px; }
  }

  /* ===== 关闭动效：全部直接显示、无位移 ===== */
  @media (prefers-reduced-motion: reduce) {
    .mood-title,
    .mood-sub,
    .mood-btn {
      opacity: 1;
      transform: none;
      transition: none;
    }

    .mood-product {
      opacity: var(--op, 1);
      transform: rotate(var(--rot, 0deg));
      transition: none;
    }
  }
</style>

<script>
  const section = document.querySelector<HTMLElement>("[data-mood-section]");
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (section) {
    if (reduce) {
      section.classList.add("mood-head-in", "mood-b1", "mood-b2", "mood-b3");
    } else {
      const parallaxEls = [...section.querySelectorAll<HTMLElement>("[data-parallax]")];
      let ticking = false;

      const update = () => {
        ticking = false;
        const rect = section.getBoundingClientRect();
        const vh = window.innerHeight;
        if (rect.bottom < 0 || rect.top > vh) return;

        // 标题按钮：section 进入视口即淡入
        if (rect.top < vh * 0.75) section.classList.add("mood-head-in");

        // 三批元素：随 section 滚入视口的进度从上到下依次出现
        const progress = Math.min(
          Math.max((vh * 0.7 - rect.top) / rect.height, 0),
          1
        );
        if (progress > 0.15) section.classList.add("mood-b1");
        if (progress > 0.35) section.classList.add("mood-b2");
        if (progress > 0.5) section.classList.add("mood-b3");

        // 顶部 / 装饰元素：轻微 parallax（10–30px）
        // translate 属性独立于出现动画的 transform，互不冲突
        const mid = rect.top + rect.height / 2 - vh / 2;
        for (const el of parallaxEls) {
          const f = parseFloat(el.dataset.parallax || "0");
          el.style.translate = `0 ${(-mid * f).toFixed(1)}px`;
        }
      };

      addEventListener(
        "scroll",
        () => {
          if (!ticking) {
            ticking = true;
            requestAnimationFrame(update);
          }
        },
        { passive: true }
      );
      update();
    }
  }
</script>
