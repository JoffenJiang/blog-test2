---
/**
 * MoodProductsSection —— 高保真参考 Wildbran "What are you in the mood for?"
 *
 * 结构模型（视觉舞台 + 底部退场空间，不是 100vh 裁切画布）：
 *   section.mood-products-section        整个区块，min-height = 100svh + 米白退场空间
 *     div.mood-products-canvas           产品视觉舞台（同高，横向裁切、纵向完整）
 *       div.mood-center                  标题 + 按钮，居中在首屏 100svh 内
 *       figure.mood-product--xxx         产品视觉组（绝对定位）
 *         div.mood-product-composite     组内复合层：产品图 + callout，overflow visible
 *           div.mood-product-img         产品图层（占位形状 / 未来的真实 img）
 *           figcaption.mood-product-callout   箭头 + 手写文字
 *   底部三组产品用 --mood-bottom-safe 抬离底边，callout 落在组的 padding-bottom 区内，
 *   保证在进入下一个暗色板块前完整可见；下一板块正常衔接，不覆盖本区。
 *
 * 动效：标题/按钮先淡入 → 随滚动分三批出现（顶部排 → 两侧小件 → 底部排）→
 *       顶部/装饰元素随滚动做 10–30px 轻微 parallax；
 *       prefers-reduced-motion 时全部直接显示。
 *
 * ★ 替换真实图片：把 .mood-product-img 里的 <div class="mood-shape ..."> 换成
 *   <img class="mood-img" src="/media/products/xxx.png" alt="" /> 即可，
 *   组的位置 / 尺寸 / 旋转 / 动效不用改。
 */
import PillButton from "./PillButton.astro";

interface Layer {
  /** 组名：定位 class 为 .mood-product--{key} */
  key: string;
  /** 占位符形状 class */
  shape: string;
  /** 出现批次：1 顶部排 / 2 两侧小件 / 3 底部排 */
  batch: 1 | 2 | 3;
  /** 批内错开延迟 */
  stagger: string;
  /** 滑入起点与最终旋转角 */
  vars: string;
  /** parallax 强度（顶部/装饰元素） */
  parallax?: number;
  /** 手写标签（仅 5 个产品有） */
  label?: string;
  /** 箭头形态（对照原站：绕圈 / 闪电 / 左弓上扬 / 下弯 / 回勾） */
  labelArrow?: keyof typeof arrows;
  /** callout 排列：箭头在前 / 文字在前 / 箭头在文字上方 */
  labelLayout?: "arrow-text" | "text-arrow" | "arrow-over-text";
}

/** 蓝色手绘箭头（五种形态，均从图片向外画、头指向文字） */
const arrows = {
  loop:   { vb: "0 0 36 20", line: "M2 13 C 3 5, 12 4, 12 10 C 12 16, 4 16, 5 10 C 6 3, 18 4, 30 8", head: "M26 4.5 30.5 8 25 10.5" },
  zigzag: { vb: "0 0 30 22", line: "M4 3 Q 12 4 15 7 Q 7 8 6 11 Q 13 14 18 15", head: "M13.5 11 19 15.5 12.5 17.5" },
  rise:   { vb: "0 0 26 26", line: "M14 24 C 4 19, 4 8, 13 3", head: "M6.5 4.5 13.5 2.5 11 9.5" },
  curl:   { vb: "0 0 20 26", line: "M17 3 C 9 5, 9 14, 6 22", head: "M3.5 16.5 6 22.5 12.5 21" },
  hook:   { vb: "0 0 24 26", line: "M18 2 C 22 9, 20 16, 10 21", head: "M15.5 16.5 9.5 21.5 16 24.5" },
};

const layers: Layer[] = [
  { key: "bites", shape: "mood-shape-bag", batch: 1, stagger: "0s", vars: "--sy:-80px;--rot:-8deg", parallax: 0.035, label: "日常杂记", labelArrow: "loop", labelLayout: "arrow-text" },
  { key: "top-blur", shape: "mood-shape-blur", batch: 1, stagger: ".1s", vars: "--sy:-60px;--op:.68", parallax: 0.06 },
  { key: "crackers", shape: "mood-shape-box mood-shape-box--red", batch: 1, stagger: ".3s", vars: "--sy:-80px;--rot:5deg", parallax: 0.04, label: "职业ootd", labelArrow: "zigzag", labelLayout: "arrow-text" },
  { key: "left-bar", shape: "mood-shape-bar", batch: 2, stagger: "0s", vars: "--sx:-70px;--rot:-8deg", parallax: 0.055 },
  { key: "right-cracker", shape: "mood-shape-piece", batch: 2, stagger: ".12s", vars: "--sx:70px;--rot:14deg" },
  { key: "cookies", shape: "mood-shape-box mood-shape-box--orange", batch: 3, stagger: "0s", vars: "--sy:80px;--rot:5deg", label: "汉服ootd", labelArrow: "curl", labelLayout: "arrow-over-text" },
  { key: "burst", shape: "mood-shape-bag mood-shape-bag--green", batch: 3, stagger: ".1s", vars: "--sy:80px;--rot:3deg", label: "环游记", labelArrow: "rise", labelLayout: "arrow-text" },
  { key: "bars", shape: "mood-shape-box mood-shape-box--purple", batch: 3, stagger: ".2s", vars: "--sy:80px;--rot:-10deg", label: "梦到什么发什么系列", labelArrow: "hook", labelLayout: "arrow-over-text" },
];

/** 用户上传的手绘装饰，替换原来的四个纯色几何占位符。 */
const uploadedDecorations: Record<
  string,
  { src: string; width: number; height: number }
> = {
  "top-blur": {
    src: "/media/products/decor-teacup.jpg",
    width: 750,
    height: 750,
  },
  "right-cracker": {
    src: "/media/products/decor-cake.jpg",
    width: 600,
    height: 600,
  },
  "left-bar": {
    src: "/media/products/decor-film.jpg",
    width: 736,
    height: 952,
  },
};

/** 五个主视觉直接使用用户上传的透明底原图，旧占位构图仅保留为源码备用。 */
const replacementProductArt: Record<
  string,
  { src: string; alt: string; width: number; height: number }
> = {
  bites: {
    src: "/media/products/palette-giveaway-composite.png",
    alt: "盘面展示 Giveaway 图片的调色板、画笔和颜料管插画",
    width: 1085,
    height: 1450,
  },
  crackers: {
    src: "/media/products/2-removebg-preview.png",
    alt: "贴有便签的手绘笔记本电脑",
    width: 500,
    height: 500,
  },
  cookies: {
    src: "/media/products/3-removebg-preview.png",
    alt: "正在吐出相纸的手绘拍立得相机",
    width: 500,
    height: 500,
  },
  bars: {
    src: "/media/products/4-removebg-preview.png",
    alt: "紫色月亮星空手绘水晶球",
    width: 500,
    height: 500,
  },
  burst: {
    src: "/media/products/5-removebg-preview.png",
    alt: "木夹悬挂的三张手绘旅行照片",
    width: 500,
    height: 500,
  },
};
---

<section
  data-mood-section
  class="mood-products-section"
  aria-label="时光日札"
>
  <div class="mood-products-canvas">
    <!-- 视觉中心：标题 + 按钮（居中在首屏 100svh 内） -->
    <div class="mood-center">
      <h2 class="mood-title font-serif font-bold">时光日札</h2>
      <p class="mood-sub">收集我的日常，工作、拍照、汉服、旅行和美食都有一点。</p>
      <div class="mood-btn mt-8">
        <PillButton href="/notes" label="来看看吧" />
      </div>
    </div>

    <!-- 10 个产品视觉组（椭圆环绕，图 + 箭头 + 文字为一个整体） -->
    {
      layers.map((l) => (
        <figure
          class:list={["mood-product", `mood-product--${l.key}`, `is--${l.key}`]}
          data-batch={l.batch}
          data-parallax={l.parallax}
          style={`${l.vars};--stg:${l.stagger}`}
        >
          <div class="mood-product-composite">
            <div class="mood-product-img">
              {replacementProductArt[l.key] ? (
                l.key === "crackers" ? (
                  <!-- 电脑屏幕保持为可替换图片层，透明屏幕边缘由原电脑外框自然遮住。 -->
                  <div
                    class="mood-laptop-composite"
                    role="img"
                    aria-label="电脑屏幕展示创意设计作品集封面"
                  >
                    <img
                      class="mood-laptop-screen-art"
                      src="/media/products/laptop-screen-portfolio.png"
                      alt=""
                      width="1400"
                      height="784"
                      aria-hidden="true"
                    />
                    <img
                      class:list={[
                        "mood-replacement-art",
                        "mood-replacement-art--crackers",
                        "mood-laptop-frame",
                      ]}
                      src={replacementProductArt[l.key].src}
                      alt=""
                      width={replacementProductArt[l.key].width}
                      height={replacementProductArt[l.key].height}
                      aria-hidden="true"
                    />
                  </div>
                ) : l.key === "bars" ? (
                  <!-- 水晶球保留透明手绘外框；球体内部是独立、可替换的圆形图片层。 -->
                  <div
                    class="mood-crystal-composite mood-replacement-art--bars"
                    role="img"
                    aria-label="水晶球中展示晾衣草地与小狗插画"
                  >
                    <img
                      class="mood-crystal-frame"
                      src={replacementProductArt[l.key].src}
                      alt=""
                      width={replacementProductArt[l.key].width}
                      height={replacementProductArt[l.key].height}
                      aria-hidden="true"
                    />
                    <img
                      class="mood-crystal-scene"
                      src="/media/products/crystal-ball-scene.png"
                      alt=""
                      width="1199"
                      height="1721"
                      aria-hidden="true"
                    />
                    <img
                      class="mood-crystal-foreground"
                      src={replacementProductArt[l.key].src}
                      alt=""
                      width={replacementProductArt[l.key].width}
                      height={replacementProductArt[l.key].height}
                      aria-hidden="true"
                    />
                  </div>
                ) : (
                  <!-- 其余主视觉直接显示用户上传的透明 PNG，不叠加旧占位符。 -->
                  <img
                    class:list={[
                      "mood-replacement-art",
                      `mood-replacement-art--${l.key}`,
                    ]}
                    src={replacementProductArt[l.key].src}
                    alt={replacementProductArt[l.key].alt}
                    width={replacementProductArt[l.key].width}
                    height={replacementProductArt[l.key].height}
                  />
                )
              ) : l.key === "__legacy-bites" ? (
                <!-- 日常杂记：复刻 F.W.DeVoe 复古调色盘广告构图 ——
                     直立蛋形调色盘（右侧指孔）+ 一束笔尖朝上、穿过指孔的画笔
                     + 左下颜料瓶 + 右下平躺大颜料管/小管/洒出的颜料/瓶盖。
                     整个盘面 = 图片占位，把图片放到 public/media/products/palette.jpg 即自动显示 -->
                <svg class="mood-palette" viewBox="0 0 340 544" fill="none" aria-hidden="true">
                  <defs>
                    <linearGradient id="mood-palette-ph" x1="0" y1="0" x2="1" y2="1">
                      <stop offset="0%" stop-color="#f2ead9" />
                      <stop offset="55%" stop-color="#e8dccb" />
                      <stop offset="100%" stop-color="#d9c9b2" />
                    </linearGradient>
                    <!-- 裁切 = 盘身减去指孔：图片填满整个盘面，指孔处透空 -->
                    <clipPath id="mood-palette-clip" clip-rule="evenodd">
                      <path
                        fill-rule="evenodd"
                        d="M158 70 C 182 68, 196 100, 208 102 C 226 105, 230 84, 248 84 C 270 84, 300 150, 304 236 C 308 322, 288 372, 250 402 C 224 424, 190 440, 150 440 C 110 440, 78 414, 62 386 C 44 358, 34 298, 34 246 C 34 194, 44 144, 62 116 C 84 84, 128 72, 158 70 Z M244.3 176.8 C 255.6 179.6, 261.9 193.1, 258.4 207.1 C 254.9 221.1, 243 230, 231.7 227.2 C 220.4 224.4, 214.1 210.9, 217.6 196.9 C 221.1 182.9, 233 174, 244.3 176.8 Z"
                      />
                    </clipPath>
                  </defs>

                  <!-- 画笔束（复刻参考特写）：8 支密排、笔杆粗、穿过指孔并把孔完全填满；
                       红木杆 + 蓝灰杆交错、长银箍、金棕平头笔毛，最右一支尖头笔 -->
                  <g transform="translate(236 200) rotate(-1)">
                    <rect x="-3" y="-130" width="6" height="200" rx="3" fill="#5d4a33" />
                    <rect x="-3.5" y="-154" width="7" height="26" rx="1.5" fill="#c8ccd0" />
                    <path d="M-3.5 -154 L3.5 -154 L2 -172 Q0 -176 -2 -172 Z" fill="#8a6b3e" />
                  </g>
                  <g transform="translate(223.5 200) rotate(-9)">
                    <rect x="-3.5" y="-92" width="7" height="162" rx="3.5" fill="#8f4a3a" />
                    <rect x="-4" y="-116" width="8" height="26" rx="1.5" fill="#b3afa6" />
                    <path d="M-4 -116 L4 -116 L2.2 -136 Q0 -140 -2.2 -136 Z" fill="#b98a3e" />
                  </g>
                  <g transform="translate(229 200) rotate(-5)">
                    <rect x="-3.5" y="-108" width="7" height="178" rx="3.5" fill="#9aa7b0" />
                    <rect x="-4" y="-134" width="8" height="28" rx="1.5" fill="#c8ccd0" />
                    <path d="M-4 -134 L4 -134 L2.2 -156 Q0 -160 -2.2 -156 Z" fill="#c99a4e" />
                  </g>
                  <g transform="translate(234 200) rotate(-3)">
                    <rect x="-3.5" y="-120" width="7" height="190" rx="3.5" fill="#a04435" />
                    <rect x="-4" y="-148" width="8" height="30" rx="1.5" fill="#b3afa6" />
                    <path d="M-4 -148 L4 -148 L2.2 -172 Q0 -176 -2.2 -172 Z" fill="#6f4a2a" />
                  </g>
                  <g transform="translate(239.5 200) rotate(2)">
                    <rect x="-4" y="-128" width="8" height="198" rx="4" fill="#b3bcc4" />
                    <rect x="-4.5" y="-158" width="9" height="32" rx="1.5" fill="#c8ccd0" />
                    <path d="M-4.5 -158 L4.5 -158 L2.5 -184 Q0 -188 -2.5 -184 Z" fill="#c99a4e" />
                  </g>
                  <g transform="translate(245 200) rotate(4)">
                    <rect x="-3.5" y="-112" width="7" height="182" rx="3.5" fill="#8f4a3a" />
                    <rect x="-4" y="-140" width="8" height="30" rx="1.5" fill="#b3afa6" />
                    <path d="M-4 -140 L4 -140 L2.2 -162 Q0 -166 -2.2 -162 Z" fill="#b98a3e" />
                  </g>
                  <g transform="translate(251 200) rotate(8)">
                    <rect x="-3.5" y="-96" width="7" height="166" rx="3.5" fill="#9aa7b0" />
                    <rect x="-4" y="-122" width="8" height="28" rx="1.5" fill="#c8ccd0" />
                    <path d="M-4 -122 L4 -122 L2.2 -144 Q0 -148 -2.2 -144 Z" fill="#6f4a2a" />
                  </g>
                  <g transform="translate(257 200) rotate(12)">
                    <rect x="-4" y="-82" width="8" height="152" rx="4" fill="#a04435" />
                    <rect x="-4.5" y="-108" width="9" height="28" rx="1.5" fill="#b3afa6" />
                    <path d="M-4.5 -108 L4.5 -108 L1.2 -128 L0 -138 L-1.2 -128 Z" fill="#c9a06b" />
                  </g>

                  <!-- 盘身（evenodd 挖出指孔）：奶白盘面，整面即占位底色 -->
                  <path
                    fill="#f6efe0"
                    fill-rule="evenodd"
                    d="M158 70 C 182 68, 196 100, 208 102 C 226 105, 230 84, 248 84 C 270 84, 300 150, 304 236 C 308 322, 288 372, 250 402 C 224 424, 190 440, 150 440 C 110 440, 78 414, 62 386 C 44 358, 34 298, 34 246 C 34 194, 44 144, 62 116 C 84 84, 128 72, 158 70 Z M244.3 176.8 C 255.6 179.6, 261.9 193.1, 258.4 207.1 C 254.9 221.1, 243 230, 231.7 227.2 C 220.4 224.4, 214.1 210.9, 217.6 196.9 C 221.1 182.9, 233 174, 244.3 176.8 Z"
                  />

                  <!-- 盘面 = 图片占位（未上传时显示暖色渐变；指孔处透空） -->
                  <g clip-path="url(#mood-palette-clip)">
                    <rect x="28" y="54" width="290" height="398" fill="url(#mood-palette-ph)" />
                    <image
                      href="/media/products/palette.jpg"
                      x="28"
                      y="54"
                      width="290"
                      height="398"
                      preserveAspectRatio="xMidYMid slice"
                    />
                  </g>

                  <!-- 左下：颜料瓶（琥珀瓶身 + 木塞 + 白标签），在盘前 -->
                  <g>
                    <rect x="86" y="300" width="24" height="22" rx="4" fill="#c9a06b" />
                    <rect x="84" y="318" width="28" height="9" rx="3" fill="#b8862b" />
                    <path d="M88 327 L108 327 L130 358 L66 358 Z" fill="#d9a441" />
                    <rect x="58" y="352" width="80" height="110" rx="10" fill="#d9a441" />
                    <rect x="64" y="384" width="68" height="52" rx="4" fill="#f6efe0" />
                    <rect x="74" y="396" width="48" height="4" rx="2" fill="#8f959e" />
                    <rect x="80" y="406" width="36" height="3" rx="1.5" fill="#b3afa6" />
                    <rect x="72" y="416" width="52" height="4" rx="2" fill="#8f959e" />
                  </g>

                  <!-- 右下：洒出的颜料 + 平躺大颜料管 + 两支小管 -->
                  <path
                    d="M150 500 C 170 492, 200 494, 214 502 C 226 510, 204 516, 182 514 C 160 512, 140 508, 150 500 Z"
                    fill="#8a5a2e"
                  />
                  <g transform="translate(196 468) rotate(-14)">
                    <path d="M2 2 L100 -6 L100 18 L2 22 Z" fill="#d8d3c8" />
                    <path d="M6 3 L6 21 M11 3 L11 20 M16 2 L16 20" stroke="#b3afa6" stroke-width="1.2" />
                    <rect x="40" y="-1" width="26" height="16" rx="2" fill="#4a5a78" />
                    <rect x="100" y="-4" width="12" height="14" rx="2" fill="#8f959e" />
                  </g>
                  <g transform="translate(284 492) rotate(8)">
                    <rect x="0" y="0" width="28" height="10" rx="2" fill="#d8d3c8" />
                    <rect x="28" y="1" width="6" height="8" rx="1.5" fill="#8f959e" />
                  </g>
                  <g transform="translate(300 428) rotate(24)">
                    <rect x="0" y="6" width="9" height="30" rx="2" fill="#d8d3c8" />
                    <rect x="1" y="0" width="7" height="6" rx="1.5" fill="#8f959e" />
                  </g>

                  <!-- 左前：掉落的小瓶盖 -->
                  <circle cx="60" cy="500" r="8" fill="#b3afa6" />
                  <circle cx="60" cy="500" r="4" fill="#8f959e" />
                </svg>
              ) : l.key === "crackers" ? (
                <!-- 职业ootd：正面绿色笔记本插画（参考编辑风 mockup）——
                     屏幕区 = 图片占位；四周便利贴 + 左侧咖啡杯 + 手绘星号点缀。
                     把图片放到 public/media/products/laptop.jpg 即自动显示 -->
                <svg class="mood-laptop" viewBox="0 0 480 430" fill="none" aria-hidden="true">
                  <defs>
                    <linearGradient id="mood-laptop-ph" x1="0" y1="0" x2="1" y2="1">
                      <stop offset="0%" stop-color="#f7f2e7" />
                      <stop offset="60%" stop-color="#efe8d8" />
                      <stop offset="100%" stop-color="#e6ddc8" />
                    </linearGradient>
                    <clipPath id="mood-laptop-clip">
                      <rect x="158" y="48" width="296" height="208" rx="4" />
                    </clipPath>
                  </defs>

                  <!-- 手绘星号（橙 / 蓝） -->
                  <g stroke-linecap="round">
                    <g stroke="#e5823a" stroke-width="6">
                      <path d="M118 66 V102 M100 84 H136 M105 71 L131 97 M131 71 L105 97" />
                    </g>
                    <g stroke="#3f7fd0" stroke-width="6">
                      <path d="M462 150 V182 M446 166 H478 M450 154 L474 178 M474 154 L450 178" />
                    </g>
                    <g stroke="#e5823a" stroke-width="5">
                      <path d="M40 196 V222 M27 209 H53 M31 200 L49 218 M49 200 L31 218" />
                    </g>
                  </g>

                  <!-- 左侧咖啡杯 + 蓝色蒸汽 -->
                  <path d="M96 214 C 104 190, 96 176, 108 158 C 118 144, 106 132, 116 120"
                        stroke="#8bb6dd" stroke-width="7" stroke-linecap="round" fill="none" />
                  <rect x="44" y="232" width="86" height="92" rx="12" fill="#efb43f" />
                  <path d="M130 250 C 152 250, 152 296, 130 296" stroke="#efb43f" stroke-width="12" fill="none" />
                  <rect x="52" y="240" width="70" height="20" rx="8" fill="#5a3b28" />

                  <!-- 屏幕（盖）：深绿边框 + 摄像头（边框收窄，图片区放大） -->
                  <rect x="152" y="42" width="308" height="220" rx="16" fill="#35503c" />
                  <circle cx="306" cy="53" r="2.6" fill="#7d9781" />
                  <!-- 屏幕内容 = 图片占位（未上传显示米白渐变） -->
                  <g clip-path="url(#mood-laptop-clip)">
                    <rect x="158" y="48" width="296" height="208" fill="url(#mood-laptop-ph)" />
                    <image
                      href="/media/products/laptop.jpg"
                      x="158"
                      y="48"
                      width="296"
                      height="208"
                      preserveAspectRatio="xMidYMid slice"
                    />
                  </g>

                  <!-- 底座（键盘面，透视梯形）+ 前缘厚度 + 键盘线 + 触控板 -->
                  <path d="M154 262 L458 262 L482 356 L130 356 Z" fill="#2f4736" />
                  <path d="M130 356 L482 356 L474 374 L138 374 Z" fill="#24382a" />
                  <g stroke="#45614c" stroke-width="2.4" stroke-linecap="round">
                    <path d="M186 278 H426 M182 292 H430 M178 306 H434" />
                    <path d="M230 270 V314 M286 270 V314 M342 270 V314 M398 270 V316" />
                  </g>
                  <rect x="256" y="322" width="100" height="26" rx="4" fill="#264031" stroke="#45614c" stroke-width="2" />

                  <!-- 便利贴（橙黄）+ 潦草笔记线，贴在屏幕上/边 -->
                  <g>
                    <g transform="translate(214 22) rotate(-6)">
                      <rect x="0" y="0" width="52" height="52" rx="2" fill="#f4b13e" />
                      <path d="M10 18 H40 M10 28 L34 26 M10 38 H36" stroke="#b5762a" stroke-width="2" stroke-linecap="round" fill="none" />
                    </g>
                    <g transform="translate(410 96) rotate(7)">
                      <rect x="0" y="0" width="50" height="50" rx="2" fill="#f4b13e" />
                      <path d="M9 16 H40 M9 26 H38 M9 36 L30 34" stroke="#b5762a" stroke-width="2" stroke-linecap="round" fill="none" />
                    </g>
                    <g transform="translate(414 160) rotate(-4)">
                      <rect x="0" y="0" width="48" height="46" rx="2" fill="#f4b13e" />
                      <path d="M9 15 H38 M9 25 H36 M9 34 H32" stroke="#b5762a" stroke-width="2" stroke-linecap="round" fill="none" />
                    </g>
                  </g>

                  <!-- 右上眼睛/评论小图标 -->
                  <g transform="translate(392 74)">
                    <rect x="0" y="0" width="34" height="28" rx="6" fill="#7a9a6a" />
                    <path d="M8 14 C 12 9, 22 9, 26 14 C 22 19, 12 19, 8 14 Z" fill="#2f4736" />
                    <circle cx="17" cy="14" r="3" fill="#7a9a6a" />
                  </g>
                </svg>
              ) : l.key === "cookies" ? (
                <!-- 汉服ootd：按用户参考图复刻的透明底手绘拍立得；
                     唯一的弯曲相纸内使用通用照片占位图。 -->
                <div class="mood-camera-reference-wrap" aria-hidden="true">
                  <img
                    class="mood-camera-reference"
                    src="/media/products/polaroid-camera-placeholder-v4.png"
                    alt=""
                    width="901"
                    height="865"
                  />
                  <canvas
                    class="mood-photo-replacement"
                    data-photo-replacement
                    width="500"
                    height="450"
                  ></canvas>
                </div>
              ) : l.key === "burst" ? (
                <!-- 环游记：三张拍立得夹在晾绳上的手绘构图。
                     将三张照片依次放到 public/media/products/trip-01.jpg ~ trip-03.jpg，
                     页面会自动用照片替换下方的占位区域。 -->
                <div class="mood-trip-polaroids" aria-hidden="true">
                  <svg
                    class="mood-trip-rope"
                    viewBox="0 0 1000 520"
                    preserveAspectRatio="none"
                    fill="none"
                  >
                    <path
                      class="mood-trip-rope__under"
                      d="M-70 72 Q475 177 1070 63"
                    />
                    <path
                      class="mood-trip-rope__over"
                      d="M-70 66 Q475 171 1070 57"
                    />
                  </svg>
                  {
                    [1, 2, 3].map((photoNumber) => (
                      <span
                        class:list={[
                          "mood-trip-card",
                          `mood-trip-card--${photoNumber}`,
                        ]}
                      >
                        <span class="mood-trip-clip">
                          <i></i>
                        </span>
                        <span
                          class="mood-trip-photo-slot"
                          data-trip-photo={`/media/products/trip-0${photoNumber}.jpg`}
                        >
                          <span class="mood-trip-placeholder-mark">
                            <i></i>
                            <b></b>
                          </span>
                          <span class="mood-trip-placeholder-label">
                            图片 {photoNumber}
                          </span>
                        </span>
                      </span>
                    ))
                  }
                </div>
              ) : l.key === "bars" ? (
                <!-- 梦到什么发什么系列：原水晶球插画作为外框，
                     用户图片裁成圆形并填满球体内部。 -->
                <div
                  class="mood-dream-scene"
                  role="img"
                  aria-label="水晶球中展示晾衣草地与小狗插画"
                >
                  <img
                    class="mood-crystal-reference"
                    src={replacementProductArt[l.key].src}
                    alt=""
                    width={replacementProductArt[l.key].width}
                    height={replacementProductArt[l.key].height}
                    loading="lazy"
                    decoding="async"
                    aria-hidden="true"
                  />
                  <img
                    class="mood-crystal-scene"
                    src="/media/products/crystal-ball-scene.png"
                    alt=""
                    width="1199"
                    height="1721"
                    loading="lazy"
                    decoding="async"
                    aria-hidden="true"
                  />
                </div>
              ) : uploadedDecorations[l.key] ? (
                <div
                  class:list={[
                    "mood-uploaded-decor",
                    `mood-uploaded-decor--${l.key}`,
                  ]}
                  aria-hidden="true"
                >
                  <img
                    src={uploadedDecorations[l.key].src}
                    alt=""
                    width={uploadedDecorations[l.key].width}
                    height={uploadedDecorations[l.key].height}
                    loading="lazy"
                    decoding="async"
                  />
                </div>
              ) : (
                <div class:list={["mood-shape", l.shape]} />
              )}
              {l.label && l.labelArrow && (
                <figcaption
                  class:list={[
                    "mood-product-callout",
                    l.labelLayout === "arrow-over-text" && "mood-product-callout--column",
                  ]}
                >
                  {l.labelLayout !== "text-arrow" && (
                    <svg
                      class="mood-product-arrow"
                      viewBox={arrows[l.labelArrow].vb}
                      fill="none"
                      aria-hidden="true"
                    >
                      <path d={arrows[l.labelArrow].line} />
                      <path d={arrows[l.labelArrow].head} />
                    </svg>
                  )}
                  <span class="mood-product-label">{l.label}</span>
                  {l.labelLayout === "text-arrow" && (
                    <svg
                      class="mood-product-arrow"
                      viewBox={arrows[l.labelArrow].vb}
                      fill="none"
                      aria-hidden="true"
                    >
                      <path d={arrows[l.labelArrow].line} />
                      <path d={arrows[l.labelArrow].head} />
                    </svg>
                  )}
                </figcaption>
              )}
            </div>
          </div>
        </figure>
      ))
    }
  </div>
</section>

<style>
  /* ===== 骨架：视觉舞台 + 底部米白退场空间 =====
   * min-height = 100svh（主要视觉舞台）+ 退场空间 + 环游记下移空间
   * 下一个暗色板块在退场空间之后正常衔接，不覆盖本区 */
  .mood-products-section {
    --mood-exit-buffer: clamp(140px, 16svh, 240px);
    --mood-burst-drop: clamp(200px, 24svh, 250px);
    --mood-bottom-safe: calc(clamp(120px, 15svh, 220px) + var(--mood-burst-drop));
    position: relative;
    z-index: 1;
    background: var(--color-bg);
    min-height: calc(100svh + var(--mood-exit-buffer) + var(--mood-burst-drop));
    /* 把过渡留白放进本区内部：视觉间距保持不变，同时让向上溢出的装饰
     * 始终处在同一米白背景/混合层中，避免跨越 margin 时出现露白断层。 */
    padding-top: var(--mood-exit-buffer);
    margin-top: 0;
    overflow-x: clip;
    overflow-y: visible;
  }

  .mood-products-canvas {
    position: relative;
    min-height: calc(100svh + var(--mood-exit-buffer) + var(--mood-burst-drop));
    background: var(--color-bg);
    /* 只裁横向（收住 left-bar / right-cracker 的两侧溢出），
     * 纵向放开：避免顶部装饰在 canvas 上边缘被削出硬直线。 */
    overflow-x: clip;
    overflow-y: visible;
    display: flex;
    align-items: flex-start;
    justify-content: center;
  }

  /* 绝对定位的插画本身不会撑开父元素。脚本完成内容边界测量后，
   * 用实际的最下边缘接管画布高度，让整个区块随内部内容自适应。 */
  .mood-products-section.mood-height-ready {
    min-height: 0;
  }

  .mood-products-canvas.mood-height-ready {
    min-height: 0;
    height: var(--mood-content-height);
  }

  .mood-height-measuring .mood-product {
    transition: none !important;
    transform: rotate(var(--rot, 0deg)) !important;
  }

  /* ===== 中间标题：居中在首屏 100svh 内 ===== */
  .mood-center {
    position: relative;
    z-index: 10;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
  }

  /* 标题字号统一约 36px（移动端略小） */
  .mood-title {
    max-width: 620px;
    font-size: 30px;
    line-height: 1.2;
  }

  @media (min-width: 640px) {
    .mood-title {
      font-size: 36px;
    }
  }

  /* 标题下副文案：15px 说明句 */
  .mood-sub {
    margin-top: 14px;
    max-width: 520px;
    font-size: 15px;
    line-height: 1.9;
    color: rgba(36, 36, 36, 0.65);
  }

  /* 标题 / 副文案 / 按钮进场 */
  .mood-title,
  .mood-sub,
  .mood-btn {
    opacity: 0;
    transform: translateY(24px);
    transition:
      opacity 0.7s ease,
      transform 0.7s ease;
  }

  .mood-sub {
    transition-delay: 0.1s;
  }

  .mood-btn {
    transition-delay: 0.2s;
  }

  .mood-head-in .mood-title,
  .mood-head-in .mood-sub,
  .mood-head-in .mood-btn {
    opacity: 1;
    transform: none;
  }

  /* ===== 产品视觉组：初始隐藏，按批次出现（动画只作用在组整体上） ===== */
  .mood-product {
    position: absolute;
    margin: 0;
    opacity: 0;
    transform: translate(var(--sx, 0px), var(--sy, 0px)) scale(0.88)
      rotate(calc(var(--rot, 0deg) + 5deg));
    transition:
      opacity 0.85s ease var(--stg, 0s),
      transform 0.85s cubic-bezier(0.25, 0.7, 0.3, 1) var(--stg, 0s);
    will-change: transform;
    pointer-events: none;
  }

  .mood-b1 .mood-product[data-batch="1"],
  .mood-b2 .mood-product[data-batch="2"],
  .mood-b3 .mood-product[data-batch="3"] {
    opacity: var(--op, 1);
    transform: translate(0, 0) scale(1) rotate(var(--rot, 0deg));
  }

  /* 组内复合层：产品图 + callout，一个整体，不裁切 callout */
  .mood-product-composite {
    position: relative;
    width: 100%;
    overflow: visible;
  }

  /* 底部三组：给 callout 预留 padding-bottom，callout 不超出组的盒子 */
  .mood-product--cookies .mood-product-composite,
  .mood-product--burst .mood-product-composite,
  .mood-product--bars .mood-product-composite {
    padding-bottom: 64px;
  }

  /* ===== 各组位置与尺寸 =====
   * 顶部 / 两侧：围绕标题的椭圆环
   * 底部三组：用 --mood-bottom-safe 抬离 section 底边，完整露出 */
  .mood-product--bites        { left: 8.5%; top: -2%;  width: 325.5px; }
  .mood-product--top-blur     { left: 42.1%; top: 3.25%; width: 60px; }
  .mood-product--crackers     { right: 5%;  top: 3.5%; width: 370px; }
  .mood-product--left-bar     { left: -4%;  top: 34%;  width: 170px; }
  .mood-product--right-cracker{ left: 51.6%; top: 15%;  width: 110px; }
  .mood-product--cookies      {
    left: 5.7%;
    bottom: calc(
      var(--mood-bottom-safe) - clamp(48px, 4vw, 62px) -
      clamp(88px, 12.3vw, 207px) + 25px
    );
    width: clamp(320px, 27vw, 415px);
  }
  /* 环游记（burst）：独占更低的一行，避免与两侧内容发生视觉冲突。 */
  .mood-product--burst        { left: 37%; bottom: calc(clamp(38px, 5svh, 82px) - 32px); width: clamp(365px, 33vw, 490px); }
  .mood-product--bars         {
    --bars-art-shift: clamp(48px, 4vw, 62px);
    --bars-callout-lift: 78px;
    right: calc(4% - 16px);
    bottom: calc(var(--mood-bottom-safe) - clamp(32px, 3vw, 46px) - 48px);
    width: clamp(322px, 29.44vw, 428px);
  }

  @media (max-width: 1023px) {
    .mood-product--bites        { width: 204.75px; }
    .mood-product--top-blur     { width: 46px; }
    .mood-product--crackers     { width: 195px; }
    .mood-product--left-bar     { width: 120px; }
    .mood-product--right-cracker{ width: 82px; }
    .mood-product--cookies      { width: clamp(240px, 28vw, 370px); }
    .mood-product--burst        { left: 33%; width: clamp(300px, 36vw, 390px); }
    .mood-product--bars         { right: calc(2.5% - 16px); width: clamp(221px, 28.52vw, 313px); }
  }

  @media (max-width: 639px) {
    .mood-products-section     { --mood-burst-drop: clamp(70px, 10svh, 100px); }
    .mood-product--bites        { width: 130.2px; left: 2%; }
    .mood-product--top-blur     { width: 36px; }
    .mood-product--right-cracker{ width: 60px; }
    .mood-product--crackers     { width: 124px; right: 2%; }
    .mood-product--left-bar     { display: none; }
    .mood-product--cookies      {
      bottom: calc(var(--mood-bottom-safe) - 4px);
      left: 6%;
      width: 180px;
    }
    .mood-product--burst        { width: 180px; left: 19%; bottom: 55px; }
    .mood-product--bars         {
      --bars-callout-lift: 34px;
      right: calc(5% - 16px);
      bottom: calc(var(--mood-bottom-safe) - 62px);
      width: 127px;
    }

    .mood-product--burst .mood-product-composite {
      padding-bottom: 0;
    }
  }

  /* ===== 产品图层与形状占位符 ===== */
  .mood-product-img {
    width: 100%;
  }

  /* 环游记标签和照片以同一图片盒为定位基准，缩放与移动始终同步。 */
  .mood-product--burst .mood-product-img {
    position: relative;
  }

  .mood-shape {
    width: 100%;
  }

  .mood-img {
    display: block;
    width: 100%;
    height: auto;
  }

  /* 五个上传的手绘装饰：通过 multiply 把素材白底自然融入米白页面。 */
  .mood-uploaded-decor {
    position: relative;
    width: 100%;
    aspect-ratio: 1;
    overflow: visible;
  }

  /* 产品组本身会因进场动画形成独立合成层，因此在组层级完成白底融合。 */
  .mood-product--top-blur,
  .mood-product--left-bar,
  .mood-product--right-cracker {
    mix-blend-mode: multiply;
  }

  .mood-uploaded-decor img {
    position: absolute;
    top: 50%;
    left: 50%;
    display: block;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: contain;
    mix-blend-mode: multiply;
    pointer-events: none;
    transform:
      translate(-50%, -50%)
      scale(var(--decor-scale, 1));
    transform-origin: center;
    user-select: none;
  }

  /* 1：猫咪茶杯使用黑白铅笔线条，白底通过 multiply 融入页面。 */
  .mood-uploaded-decor--top-blur {
    --decor-scale: 2.18;
  }

  .mood-uploaded-decor--top-blur img {
    filter: grayscale(1) blur(1.2px) contrast(1.12) brightness(0.98);
    -webkit-mask-image: radial-gradient(
      ellipse 36% 38% at 51% 51%,
      #000 62%,
      transparent 100%
    );
    mask-image: radial-gradient(
      ellipse 36% 38% at 51% 51%,
      #000 62%,
      transparent 100%
    );
  }

  /* 3：蛋糕从右侧探入，替换原来的小圆角块。 */
  .mood-uploaded-decor--right-cracker {
    --decor-scale: 3.2;
  }

  .mood-uploaded-decor--right-cracker img {
    /* 只保留上方的蛋糕插画，裁掉原素材下方手写的 “cake” 字样。 */
    -webkit-mask-image: linear-gradient(to bottom, #000 0 58%, transparent 61%);
    mask-image: linear-gradient(to bottom, #000 0 58%, transparent 61%);
  }

  /* 4：胶卷保留竖向轮廓，并延续左侧半露出的构图。 */
  .mood-uploaded-decor--left-bar {
    --decor-scale: 2.62;
    aspect-ratio: 1.28;
  }

  .mood-uploaded-decor--left-bar img {
    -webkit-mask-image: radial-gradient(ellipse 38% 34% at 51% 48%, #000 58%, transparent 100%);
    mask-image: radial-gradient(ellipse 38% 34% at 51% 48%, #000 58%, transparent 100%);
  }

  /* 五个主视觉：透明底原图完整展示，与页面米白背景自然融合。 */
  .mood-replacement-art {
    display: block;
    width: 100%;
    height: auto;
    object-fit: contain;
  }

  /* 电脑屏幕是独立图片占位层：原 PNG 的屏幕区域本身透明，
   * 作品图片铺在背后，外框、便签与键盘继续由原插画完整覆盖。 */
  .mood-laptop-composite {
    position: relative;
    width: 100%;
    aspect-ratio: 1;
  }

  .mood-laptop-screen-art {
    position: absolute;
    z-index: 1;
    left: 15.6%;
    top: 15%;
    width: 67.8%;
    height: 49%;
    display: block;
    object-fit: cover;
    object-position: center;
  }

  .mood-laptop-frame {
    position: absolute;
    z-index: 2;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  /* 水晶球球体是独立图片占位层：用户图片裁成圆形后覆盖原球体，
   * 外圈、底座以及周围的月亮和星星仍由透明 PNG 保留。 */
  .mood-crystal-composite {
    position: relative;
    width: 100%;
    aspect-ratio: 1;
  }

  .mood-crystal-frame {
    position: absolute;
    z-index: 1;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    pointer-events: none;
    user-select: none;
  }

  .mood-crystal-composite .mood-crystal-scene {
    position: absolute;
    z-index: 2;
    top: 20.4%;
    left: 28.3%;
    display: block;
    width: 43.8%;
    height: 44.2%;
    box-sizing: border-box;
    border: clamp(1px, 0.14vw, 2px) solid rgba(39, 36, 31, 0.88);
    border-radius: 50%;
    object-fit: cover;
    object-position: center 58%;
    filter:
      saturate(0.94)
      contrast(0.98);
    pointer-events: none;
    user-select: none;
  }

  /* 同一张透明水晶球插画再作为前景叠一层，仅露出底部区域。
   * 这样金色底座会自然遮住球体下缘，而不会被圆形图片覆盖。 */
  .mood-crystal-foreground {
    position: absolute;
    z-index: 3;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    clip-path: inset(62.8% 0 0 0);
    pointer-events: none;
    user-select: none;
  }

  /* 沿用旧构图的视觉基线，避免替换图片后整体上下跳动。 */
  .mood-replacement-art--cookies {
    transform: translateY(clamp(16px, 1.6vw, 24px));
  }

  .mood-replacement-art--bars {
    transform: translateY(var(--bars-art-shift));
  }

  /* 第 5 张原图是正方形透明画布，实际照片串集中在中下部；
   * 用负外边距压缩透明留白，使它保持原来横向照片串的占位高度。 */
  .mood-replacement-art--burst {
    margin-top: -26%;
    margin-bottom: -20%;
  }

  /* 旧调色盘 SVG / 职业ootd 笔记本 SVG（宽度随组，高度按 viewBox 等比） */
  .mood-palette,
  .mood-laptop {
    display: block;
    width: 100%;
    height: auto;
  }

  /* 汉服ootd：新参考图本身已朝右，无需镜像。 */
  .mood-camera-reference-wrap {
    position: relative;
    width: 100%;
    /* 相机向下贴近自己的标签；组本身也已下移，与左侧胶卷拉开距离。 */
    transform: translateY(clamp(16px, 1.6vw, 24px));
  }

  .mood-camera-reference {
    display: block;
    width: 100%;
    height: auto;
    filter: drop-shadow(0 12px 11px rgba(39, 39, 35, 0.1));
    user-select: none;
  }

  /* 上传照片会在 canvas 内做网格变形，跟随相纸的弧度与透视，
   * 而不是用一张生硬的平面矩形直接覆盖原占位图。 */
  .mood-photo-replacement {
    position: absolute;
    z-index: 2;
    top: 48%;
    left: 44.8%;
    display: none;
    width: 49.4%;
    height: 45.7%;
    filter:
      drop-shadow(0 1px 0 rgba(255, 255, 255, 0.3))
      drop-shadow(0 2px 2px rgba(39, 39, 35, 0.08));
    pointer-events: none;
  }

  .mood-photo-replacement.has-photo {
    display: block;
  }

  /* 环游记：晾绳 + 三张有轻微错位的拍立得。 */
  .mood-trip-polaroids {
    position: relative;
    width: 100%;
    aspect-ratio: 2 / 1.08;
    filter: drop-shadow(0 10px 9px rgba(36, 31, 26, 0.11));
  }

  .mood-trip-rope {
    position: absolute;
    z-index: 0;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
  }

  .mood-trip-rope path {
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }

  .mood-trip-rope__under {
    stroke: rgba(181, 145, 104, 0.42);
    stroke-width: 4.8;
  }

  .mood-trip-rope__over {
    stroke: #322a24;
    stroke-width: 2.5;
  }

  .mood-trip-card {
    position: absolute;
    z-index: 1;
    top: 22%;
    display: block;
    width: 31.5%;
    aspect-ratio: 0.74;
    border: 2px solid rgba(57, 45, 35, 0.92);
    border-radius: 2px;
    background: #cfe4ad;
    box-shadow:
      inset 0 0 0 2px rgba(255, 255, 255, 0.34),
      4px 6px 0 rgba(48, 43, 36, 0.08);
    transform-origin: 50% 7%;
  }

  .mood-trip-card::before {
    content: "♥  ·  ♥  ·  ♥\A·  ♥  ·  ♥  ·\A♥  ·  ♥  ·  ♥\A·  ♥  ·  ♥  ·\A♥  ·  ♥  ·  ♥\A·  ♥  ·  ♥  ·\A♥  ·  ♥  ·  ♥";
    position: absolute;
    z-index: 0;
    inset: 4px;
    overflow: hidden;
    color: #bc6e9b;
    font-family: Georgia, serif;
    font-size: clamp(8px, 0.72vw, 11px);
    line-height: 1.78;
    letter-spacing: 0.22em;
    white-space: pre;
    opacity: 0.78;
    pointer-events: none;
  }

  .mood-trip-card::after {
    content: "♥   ♥   ♥   ♥";
    position: absolute;
    z-index: 2;
    right: 5%;
    bottom: 4%;
    left: 5%;
    overflow: hidden;
    color: #bc6e9b;
    font-family: Georgia, serif;
    font-size: clamp(9px, 0.8vw, 12px);
    letter-spacing: 0.12em;
    text-align: center;
    white-space: nowrap;
    pointer-events: none;
  }

  .mood-trip-card--1 {
    z-index: 2;
    left: 0;
    transform: rotate(-5deg);
  }

  .mood-trip-card--2 {
    z-index: 4;
    top: 23%;
    left: 32.5%;
    width: 34%;
    background: #e98c83;
    transform: rotate(-16deg);
  }

  .mood-trip-card--2::before {
    content: "✿   ✿  ·  ✿\A  ✿  ·  ✿\A✿  ·  ✿   ✿\A  ✿  ·  ✿\A✿   ✿  ·  ✿\A  ✿  ·  ✿\A✿  ·  ✿   ✿";
    color: #fff0bf;
    font-family: Arial, sans-serif;
    font-size: clamp(10px, 0.9vw, 14px);
    line-height: 1.55;
    opacity: 0.92;
  }

  .mood-trip-card--2::after {
    content: "✿   ✿   ✿   ✿";
    color: #fff0bf;
    font-family: Arial, sans-serif;
    font-size: clamp(11px, 0.95vw, 15px);
  }

  .mood-trip-card--3 {
    z-index: 3;
    top: 21%;
    right: 5.5%;
    width: 31%;
    background: #bfd9d4;
    transform: rotate(9deg);
  }

  .mood-trip-card--3::before {
    content: "✦  ·  ✦  ·  ✦\A  ·  ✦  ·  ✦\A✦  ·  ✦  ·  ✦\A  ·  ✦  ·  ✦\A✦  ·  ✦  ·  ✦\A  ·  ✦  ·  ✦\A✦  ·  ✦  ·  ✦";
    color: #f6c96f;
    font-family: Georgia, serif;
    font-size: clamp(9px, 0.78vw, 12px);
    line-height: 1.7;
    opacity: 0.9;
  }

  .mood-trip-card--3::after {
    content: "✦   ✦   ✦   ✦";
    color: #f6c96f;
    font-family: Georgia, serif;
    font-size: clamp(10px, 0.88vw, 14px);
  }

  .mood-trip-photo-slot {
    position: absolute;
    z-index: 1;
    top: 6%;
    left: 5.5%;
    display: flex;
    width: 89%;
    height: 69%;
    overflow: hidden;
    align-items: center;
    justify-content: center;
    border: 1.5px solid rgba(54, 51, 46, 0.7);
    background:
      linear-gradient(145deg, rgba(255, 255, 255, 0.52), transparent 48%),
      #ddd8cb;
    background-position: center;
    background-size: cover;
  }

  .mood-trip-photo-slot.has-photo {
    background-image: var(--trip-photo-url);
  }

  .mood-trip-photo-slot.has-photo > * {
    display: none;
  }

  .mood-trip-placeholder-mark {
    position: absolute;
    inset: 0;
    opacity: 0.48;
  }

  .mood-trip-placeholder-mark::before {
    content: "";
    position: absolute;
    right: 16%;
    top: 15%;
    width: 13%;
    aspect-ratio: 1;
    border: 1.5px solid #6f6c66;
    border-radius: 50%;
  }

  .mood-trip-placeholder-mark i,
  .mood-trip-placeholder-mark b {
    position: absolute;
    bottom: -4%;
    display: block;
    width: 74%;
    height: 58%;
    background: #a9aaa5;
    clip-path: polygon(0 100%, 42% 24%, 59% 48%, 76% 17%, 100% 100%);
  }

  .mood-trip-placeholder-mark i {
    left: -4%;
  }

  .mood-trip-placeholder-mark b {
    right: -19%;
    opacity: 0.72;
    transform: scale(0.74);
  }

  .mood-trip-placeholder-label {
    position: relative;
    z-index: 2;
    padding: 3px 7px;
    border: 1px solid rgba(71, 68, 63, 0.35);
    border-radius: 999px;
    background: rgba(246, 242, 234, 0.76);
    color: rgba(58, 56, 52, 0.72);
    font-family: var(--font-art);
    font-size: clamp(9px, 0.78vw, 12px);
    letter-spacing: 0.08em;
  }

  /* 实木夹：暖棕木色双片结构、中心弹簧与轻微木纹。 */
  .mood-trip-clip {
    position: absolute;
    z-index: 5;
    top: -15%;
    left: 44%;
    display: block;
    width: 11.5%;
    height: 29%;
    border: 1.8px solid #3d2a1d;
    border-radius: 3px 3px 2px 2px;
    background:
      repeating-linear-gradient(
        0deg,
        transparent 0 9px,
        rgba(107, 57, 25, 0.16) 9px 10px
      ),
      linear-gradient(90deg, #e2a75f 0%, #c77b38 62%, #ab6029 100%);
    box-shadow:
      inset 2px 0 0 rgba(255, 224, 169, 0.42),
      3px 3px 0 rgba(55, 37, 24, 0.2);
    transform: rotate(8deg);
  }

  .mood-trip-clip::before {
    content: "";
    position: absolute;
    right: -28%;
    top: 11%;
    width: 28%;
    height: 82%;
    border: 1.5px solid #3d2a1d;
    border-left: 0;
    border-radius: 0 3px 3px 0;
    background:
      repeating-linear-gradient(
        0deg,
        transparent 0 8px,
        rgba(90, 45, 19, 0.15) 8px 9px
      ),
      linear-gradient(#c7813f, #a85c28);
    box-shadow: 2px 2px 0 rgba(55, 37, 24, 0.14);
    transform: skewY(7deg);
  }

  .mood-trip-clip::after {
    content: "";
    position: absolute;
    left: 38%;
    top: 46%;
    width: 27%;
    aspect-ratio: 1;
    border: 1.5px solid #3d2a1d;
    border-radius: 50%;
    background: #e6c48d;
    box-shadow: 0 0 0 1px rgba(255, 236, 199, 0.35);
  }

  .mood-trip-clip i {
    position: absolute;
    left: 49%;
    top: 8%;
    width: 1.5px;
    height: 82%;
    background: rgba(78, 42, 21, 0.62);
    box-shadow: 3px 0 0 rgba(255, 213, 151, 0.2);
    transform: rotate(0);
  }

  .mood-trip-card--1 .mood-trip-clip {
    left: 44%;
    transform: rotate(13deg);
  }

  .mood-trip-card--2 .mood-trip-clip {
    left: 44%;
    transform: rotate(-9deg);
  }

  .mood-trip-card--3 .mood-trip-clip {
    left: 47.5%;
    transform: rotate(8deg);
  }

  /* 梦到什么发什么系列：外框与圆形图片层组成一个完整水晶球。
   * 圆形层略微内缩，完整保留手绘黑色轮廓、金色底座与外围装饰。 */
  .mood-dream-scene {
    position: relative;
    width: 100%;
    aspect-ratio: 1.12;
    overflow: visible;
    /* 水晶球与下方标题属于同一组：下移图形，收紧两者的视觉距离。 */
    transform: translateY(clamp(48px, 4vw, 62px));
  }

  .mood-product--bars {
    mix-blend-mode: normal;
  }

  .mood-crystal-reference {
    position: absolute;
    z-index: 1;
    top: 50%;
    left: 50%;
    display: block;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: contain;
    mix-blend-mode: normal;
    filter:
      saturate(1.04)
      contrast(1.03)
      drop-shadow(0 13px 13px rgba(67, 58, 82, 0.1));
    transform: translate(-50%, -50%) scale(1.18);
    transform-origin: center;
    pointer-events: none;
    user-select: none;
  }

  .mood-crystal-scene {
    position: absolute;
    z-index: 2;
    top: 21.8%;
    left: 29.8%;
    display: block;
    width: 40.8%;
    aspect-ratio: 1;
    border-radius: 50%;
    object-fit: cover;
    object-position: center 58%;
    filter:
      saturate(0.94)
      contrast(0.98);
    pointer-events: none;
    user-select: none;
  }

  .mood-crystal-ball {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .mood-crystal-globe {
    position: absolute;
    z-index: 3;
    top: 1.5%;
    left: 50%;
    display: block;
    width: 68%;
    aspect-ratio: 1;
    overflow: hidden;
    border: clamp(2px, 0.32vw, 4px) solid #7667a6;
    border-radius: 50%;
    background:
      radial-gradient(circle at 24% 29%, rgba(255, 244, 176, 0.95) 0 1.2%, transparent 1.5%),
      radial-gradient(circle at 72% 21%, rgba(255, 205, 116, 0.9) 0 1.1%, transparent 1.45%),
      radial-gradient(circle at 77% 66%, rgba(245, 173, 190, 0.9) 0 1.4%, transparent 1.75%),
      radial-gradient(circle at 35% 73%, rgba(169, 230, 214, 0.95) 0 1%, transparent 1.35%),
      radial-gradient(circle at 50% 50%, #c7b5e9 0%, #9d91d0 46%, #778bc3 76%, #6575ad 100%);
    box-shadow:
      inset 0 0 0 5px rgba(255, 249, 234, 0.34),
      inset -14px -18px 25px rgba(74, 64, 122, 0.2),
      0 9px 18px rgba(68, 57, 104, 0.17);
    transform: translateX(-50%);
  }

  .mood-dream-image {
    position: absolute;
    z-index: 1;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .mood-crystal-placeholder {
    position: absolute;
    z-index: 0;
    inset: 0;
    display: block;
    background:
      radial-gradient(ellipse at center, transparent 0 29%, rgba(255, 232, 166, 0.64) 29.5% 31%, transparent 31.5%),
      radial-gradient(ellipse at center, transparent 0 43%, rgba(181, 236, 222, 0.5) 43.5% 45%, transparent 45.5%);
    transform: rotate(-12deg);
  }

  .mood-crystal-placeholder i,
  .mood-crystal-placeholder b,
  .mood-crystal-placeholder em {
    position: absolute;
    display: block;
    font-style: normal;
  }

  .mood-crystal-placeholder i {
    top: 25%;
    left: 31%;
    color: #fff3b0;
    font-family: Georgia, serif;
    font-size: clamp(34px, 4.2vw, 58px);
    line-height: 1;
    text-shadow: 0 0 12px rgba(255, 237, 158, 0.56);
    transform: rotate(12deg);
  }

  .mood-crystal-placeholder b {
    top: 31%;
    right: 29%;
    color: #ffe087;
    font-size: clamp(17px, 2vw, 28px);
    line-height: 1;
    text-shadow: 0 0 8px rgba(255, 225, 132, 0.55);
    transform: rotate(12deg);
  }

  .mood-crystal-placeholder em {
    left: 50%;
    bottom: 20%;
    padding: 4px 10px;
    border: 1px solid rgba(255, 249, 229, 0.58);
    border-radius: 999px;
    background: rgba(85, 75, 137, 0.34);
    color: rgba(255, 250, 235, 0.88);
    font-family: var(--font-art);
    font-size: clamp(9px, 0.78vw, 12px);
    letter-spacing: 0.08em;
    white-space: nowrap;
    transform: translateX(-50%) rotate(12deg);
  }

  .mood-crystal-shine {
    position: absolute;
    z-index: 2;
    top: 11%;
    left: 14%;
    width: 22%;
    height: 38%;
    border: clamp(3px, 0.5vw, 7px) solid rgba(255, 255, 255, 0.58);
    border-right-color: transparent;
    border-bottom-color: transparent;
    border-radius: 60% 45% 55% 45%;
    filter: blur(0.2px);
    transform: rotate(25deg);
    pointer-events: none;
  }

  .mood-crystal-orbit {
    position: absolute;
    z-index: 4;
    top: 34%;
    left: 50%;
    display: block;
    width: 77%;
    height: 20%;
    border: clamp(2px, 0.24vw, 3px) solid rgba(229, 172, 92, 0.84);
    border-radius: 50%;
    box-shadow:
      inset 0 0 0 2px rgba(255, 236, 184, 0.18),
      0 2px 0 rgba(114, 88, 138, 0.2);
    transform: translateX(-50%) rotate(-10deg);
    pointer-events: none;
  }

  .mood-crystal-collar {
    position: absolute;
    z-index: 5;
    top: 67%;
    left: 50%;
    display: block;
    width: 52%;
    height: 10%;
    border: clamp(2px, 0.28vw, 4px) solid #765885;
    border-radius: 50%;
    background: linear-gradient(180deg, #ffe1a5 0%, #f3af87 54%, #cc7990 100%);
    box-shadow:
      inset 0 4px 0 rgba(255, 249, 210, 0.48),
      0 5px 8px rgba(71, 52, 91, 0.16);
    transform: translateX(-50%);
  }

  .mood-crystal-base {
    position: absolute;
    z-index: 2;
    top: 72%;
    left: 50%;
    display: block;
    width: 58%;
    height: 23%;
    overflow: hidden;
    background: #765885;
    clip-path: polygon(15% 0, 85% 0, 100% 88%, 91% 100%, 9% 100%, 0 88%);
    transform: translateX(-50%);
  }

  .mood-crystal-base::before {
    content: "";
    position: absolute;
    z-index: 0;
    inset: clamp(2px, 0.28vw, 4px);
    background:
      linear-gradient(150deg, rgba(255, 250, 214, 0.4), transparent 38%),
      linear-gradient(180deg, #f7bd91 0%, #da8fa4 52%, #a47db3 100%);
    clip-path: polygon(15% 0, 85% 0, 100% 88%, 91% 100%, 9% 100%, 0 88%);
  }

  .mood-crystal-base::after {
    content: "";
    position: absolute;
    z-index: 1;
    right: 9%;
    bottom: 11%;
    left: 9%;
    height: 2px;
    border-radius: 999px;
    background: rgba(255, 231, 178, 0.48);
  }

  .mood-crystal-base i,
  .mood-crystal-base b,
  .mood-crystal-base em {
    position: absolute;
    z-index: 2;
    top: 38%;
    display: block;
    color: #fff0a8;
    font-style: normal;
    font-size: clamp(12px, 1.25vw, 18px);
    line-height: 1;
    text-shadow: 0 1px 0 rgba(108, 72, 117, 0.28);
  }

  .mood-crystal-base i {
    left: 24%;
  }

  .mood-crystal-base b {
    left: 50%;
    color: #b9e6d8;
    transform: translateX(-50%);
  }

  .mood-crystal-base em {
    right: 24%;
  }

  .mood-crystal-sparks {
    position: absolute;
    z-index: 6;
    inset: 0;
    display: block;
    pointer-events: none;
  }

  .mood-crystal-sparks i {
    position: absolute;
    display: block;
    color: #f2b548;
    font-style: normal;
    font-size: clamp(13px, 1.5vw, 22px);
    line-height: 1;
  }

  .mood-crystal-sparks i:nth-child(1) { top: 15%; left: 8%; color: #d9869e; }
  .mood-crystal-sparks i:nth-child(2) { top: 24%; right: 7%; color: #e6a53f; }
  .mood-crystal-sparks i:nth-child(3) { top: 45%; left: 3%; color: #69b5ad; }
  .mood-crystal-sparks i:nth-child(4) { top: 12%; right: 14%; color: #866bb1; }
  .mood-crystal-sparks i:nth-child(5) { top: 55%; right: 3%; color: #e98aa2; }
  .mood-crystal-sparks i:nth-child(6) { top: 51%; left: 10%; color: #eab54e; }

  /* 参考海报里围绕相机的手绘小符号：旋涡、叶片、扇形笔触与果实。
   * 用页面的浅暖金色呈现，避免在米白背景上消失。 */
  /* 包装袋：圆角矩形 + 顶部封口 */
  .mood-shape-bag {
    aspect-ratio: 4 / 5;
    background: #e6cf9d;
    border-radius: 14% / 11%;
    position: relative;
  }

  .mood-shape-bag::before {
    content: "";
    position: absolute;
    left: 4%;
    right: 4%;
    top: 0;
    height: 9%;
    background: #d0b276;
    border-radius: 999px;
  }

  .mood-shape-bag--green {
    background: #ccd6ad;
  }

  .mood-shape-bag--green::before {
    background: #aebb85;
  }

  /* 盒子：圆角矩形 + 左侧深色棱面（轻微 3D 感） */
  .mood-shape-box {
    aspect-ratio: 3 / 4;
    background: #f1e6cf;
    border-radius: 6% / 4.5%;
    position: relative;
  }

  .mood-shape-box::before {
    content: "";
    position: absolute;
    left: 0;
    top: 2%;
    bottom: 2%;
    width: 11%;
    border-radius: 6px 0 0 6px;
    transform: skewY(-4deg);
  }

  .mood-shape-box--red::before {
    background: #bc4a35;
  }

  .mood-shape-box--orange {
    background: #f4ead6;
  }

  .mood-shape-box--orange::before {
    background: #cc8544;
  }

  .mood-shape-box--purple {
    aspect-ratio: 1;
    background: #e7dbf0;
  }

  .mood-shape-box--purple::before {
    background: #a687c6;
  }

  /* 圆形食物 */
  .mood-shape-ball {
    aspect-ratio: 1;
    background: #a2734a;
    border-radius: 50%;
  }

  /* 横向食物块（巧克力 bar）：不规则圆角 */
  .mood-shape-bar {
    aspect-ratio: 2.4 / 1;
    background: #6f4a2a;
    border-radius: 44% 56% 52% 48% / 55% 45% 60% 40%;
  }

  /* 小饼干块：不规则圆角小方块 */
  .mood-shape-piece {
    aspect-ratio: 1 / 0.9;
    background: #d9b98c;
    border-radius: 38% 62% 55% 45% / 48% 52% 45% 55%;
  }

  /* 灰色模糊圆形装饰 */
  .mood-shape-blur {
    aspect-ratio: 1;
    background: #b3afa6;
    border-radius: 50%;
    filter: blur(6px);
  }

  /* ===== callout：蓝色手绘箭头 + 黑色手写文字，绑定在组内 ===== */
  .mood-product-callout {
    position: absolute;
    display: flex;
    align-items: center;
    gap: 7px;
    white-space: nowrap;
    margin: 0;
  }

  .mood-product-callout--column {
    flex-direction: column;
    align-items: flex-start;
    gap: 3px;
  }

  /* 中文标签使用中文手写体（font-art：马善政楷体系） */
  .mood-product-label {
    font-family: var(--font-art);
    font-size: 20px;
    line-height: 1;
    color: var(--color-ink);
  }

  .mood-product-arrow {
    display: block;
    width: 32px;
    height: auto;
    flex-shrink: 0;
    color: var(--color-blue);
  }

  .mood-product-arrow path {
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  @media (max-width: 1023px) {
    .mood-product-label {
      font-size: 18px;
    }

    .mood-product-arrow {
      width: 26px;
    }
  }

  /* 各组 callout 位置：贴近产品图但不接触；
   * 底部三组的 callout 落在 composite 的 padding-bottom 区内，不会被裁切 */
  .is--bites .mood-product-callout    { left: calc(100% + 9px); right: auto; top: 62%; }
  .is--crackers .mood-product-callout { left: 44%; bottom: -42px; }
  /* 相机原图左侧带有透明留白：标签收进画布并上移到相纸左侧。 */
  .is--cookies .mood-product-callout  {
    left: auto;
    right: calc(63% + 8px);
    bottom: 80px;
    transform: translateX(-4px);
  }
  /* 原图可见内容从画布高度的 27.6% 开始：标签贴着这条视觉边缘，
   * 留出 8px 呼吸距离，并略向右靠近照片主体。 */
  .is--burst .mood-product-callout    {
    left: 50%;
    top: 27.6%;
    flex-direction: column-reverse;
    align-items: center;
    gap: 3px;
    transform: translateY(calc(-100% - 8px));
  }
  .is--bars .mood-product-callout {
    left: 50%;
    right: auto;
    top: calc(
      100% - 64px + var(--bars-art-shift) + 6px -
      var(--bars-callout-lift)
    );
    bottom: auto;
    align-items: center;
    gap: 3px;
    transform: translateX(-50%);
  }
  .is--bars .mood-product-label {
    display: block;
    transform: none;
  }
  .is--bars .mood-product-arrow {
    width: clamp(28px, 2.4vw, 36px);
    transform: none;
  }
  .is--bars .mood-product-arrow path {
    stroke-width: 2.5;
  }

  @media (max-width: 639px) {
    .is--crackers .mood-product-callout { left: 0; bottom: -36px; }
    .is--cookies .mood-product-callout  {
      left: auto;
      right: calc(63% + 8px);
      bottom: 34px;
      transform: translateX(-2px);
    }
    .is--burst .mood-product-callout    {
      left: 50%;
      top: 27.6%;
      flex-direction: column-reverse;
      align-items: center;
      gap: 3px;
      transform: translateY(calc(-100% - 8px));
    }
  }

  /* ===== 关闭动效：全部直接显示、无位移 ===== */
  @media (prefers-reduced-motion: reduce) {
    .mood-title,
    .mood-sub,
    .mood-btn {
      opacity: 1;
      transform: none;
      transition: none;
    }

    .mood-product {
      opacity: var(--op, 1);
      transform: rotate(var(--rot, 0deg));
      transition: none;
    }
  }
</style>

<style is:global>
  /*
   * Keep the travel-note label and its hanging photos together while
   * lowering the complete artwork by the requested 20px.
   */
  :where(div, figure, a):has(
    > img[src*="5-removebg"],
    > img[alt*="环游"],
    > img[alt*="一串相片"]
  ) {
    translate: 0 20px;
  }
</style>

<script>
  const section = document.querySelector<HTMLElement>("[data-mood-section]");
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  // 占位图片（调色盘盘面 / 笔电屏幕）：尚未上传（404）时移除 <image>，露出下方渐变占位。
  // 脚本晚于 SVG 解析执行，error 事件可能已错过，故用 Image() 重新探测同一 URL。
  document.querySelectorAll<SVGImageElement>(".mood-palette image, .mood-laptop image").forEach((img) => {
    const probe = new Image();
    probe.onerror = () => img.remove();
    probe.src = img.href.baseVal;
  });

  type PhotoPoint = { x: number; y: number };
  type PhotoTriangle = [PhotoPoint, PhotoPoint, PhotoPoint];

  const drawPhotoTriangle = (
    ctx: CanvasRenderingContext2D,
    image: HTMLImageElement,
    source: PhotoTriangle,
    target: PhotoTriangle,
  ) => {
    const [s0, s1, s2] = source;
    const [t0, t1, t2] = target;
    const denominator =
      s0.x * (s1.y - s2.y) +
      s1.x * (s2.y - s0.y) +
      s2.x * (s0.y - s1.y);

    if (!denominator) return;

    const a =
      (t0.x * (s1.y - s2.y) +
        t1.x * (s2.y - s0.y) +
        t2.x * (s0.y - s1.y)) /
      denominator;
    const b =
      (t0.y * (s1.y - s2.y) +
        t1.y * (s2.y - s0.y) +
        t2.y * (s0.y - s1.y)) /
      denominator;
    const c =
      (t0.x * (s2.x - s1.x) +
        t1.x * (s0.x - s2.x) +
        t2.x * (s1.x - s0.x)) /
      denominator;
    const d =
      (t0.y * (s2.x - s1.x) +
        t1.y * (s0.x - s2.x) +
        t2.y * (s1.x - s0.x)) /
      denominator;
    const e =
      (t0.x * (s1.x * s2.y - s2.x * s1.y) +
        t1.x * (s2.x * s0.y - s0.x * s2.y) +
        t2.x * (s0.x * s1.y - s1.x * s0.y)) /
      denominator;
    const f =
      (t0.y * (s1.x * s2.y - s2.x * s1.y) +
        t1.y * (s2.x * s0.y - s0.x * s2.y) +
        t2.y * (s0.x * s1.y - s1.x * s0.y)) /
      denominator;

    ctx.save();
    ctx.beginPath();
    ctx.moveTo(t0.x, t0.y);
    ctx.lineTo(t1.x, t1.y);
    ctx.lineTo(t2.x, t2.y);
    ctx.closePath();
    ctx.clip();
    ctx.setTransform(a, b, c, d, e, f);
    ctx.drawImage(image, 0, 0);
    ctx.restore();
  };

  const drawCurvedPhoto = (
    canvas: HTMLCanvasElement,
    image: HTMLImageElement,
  ) => {
    const ctx = canvas.getContext("2d");
    if (!ctx) return;

    const width = canvas.width;
    const height = canvas.height;
    const targetRatio = width / height;
    const imageRatio = image.naturalWidth / image.naturalHeight;
    let cropX = 0;
    let cropY = 0;
    let cropWidth = image.naturalWidth;
    let cropHeight = image.naturalHeight;

    if (imageRatio > targetRatio) {
      cropWidth = image.naturalHeight * targetRatio;
      cropX = (image.naturalWidth - cropWidth) / 2;
    } else {
      cropHeight = image.naturalWidth / targetRatio;
      cropY = (image.naturalHeight - cropHeight) / 2;
    }

    const columns = 18;
    const rows = 18;
    const point = (u: number, v: number): PhotoPoint => {
      const sine = Math.sin(Math.PI * u);
      const topX = width * 0.59 * u;
      const bottomX = width * (0.4 + 0.6 * u);
      const topY = height * (0.05 * (1 - u)) - height * 0.018 * sine;
      const bottomY = height * (1 - 0.26 * u) + height * 0.022 * sine;

      return {
        x:
          topX * (1 - v) +
          bottomX * v +
          width * 0.012 * sine * Math.sin(Math.PI * v),
        y: topY * (1 - v) + bottomY * v,
      };
    };
    const sourcePoint = (u: number, v: number): PhotoPoint => ({
      x: cropX + cropWidth * u,
      y: cropY + cropHeight * v,
    });

    ctx.clearRect(0, 0, width, height);
    ctx.imageSmoothingEnabled = true;
    ctx.imageSmoothingQuality = "high";

    for (let row = 0; row < rows; row += 1) {
      for (let column = 0; column < columns; column += 1) {
        const u0 = column / columns;
        const u1 = (column + 1) / columns;
        const v0 = row / rows;
        const v1 = (row + 1) / rows;
        const s00 = sourcePoint(u0, v0);
        const s10 = sourcePoint(u1, v0);
        const s01 = sourcePoint(u0, v1);
        const s11 = sourcePoint(u1, v1);
        const t00 = point(u0, v0);
        const t10 = point(u1, v0);
        const t01 = point(u0, v1);
        const t11 = point(u1, v1);

        drawPhotoTriangle(ctx, image, [s00, s10, s11], [t00, t10, t11]);
        drawPhotoTriangle(ctx, image, [s00, s11, s01], [t00, t11, t01]);
      }
    }

    ctx.save();
    ctx.globalCompositeOperation = "source-atop";
    const paperLight = ctx.createLinearGradient(0, 0, width, height);
    paperLight.addColorStop(0, "rgba(255, 255, 255, 0.18)");
    paperLight.addColorStop(0.45, "rgba(255, 255, 255, 0)");
    paperLight.addColorStop(0.78, "rgba(34, 45, 56, 0.04)");
    paperLight.addColorStop(1, "rgba(34, 45, 56, 0.13)");
    ctx.fillStyle = paperLight;
    ctx.fillRect(0, 0, width, height);
    ctx.restore();
  };

  // 把 public/media/products/photo.png 变形映射到弯曲相纸内；
  // 文件尚未上传时，继续显示素材自带的照片占位图。
  // 查询参数用于绕过已删除图片的浏览器缓存，确保删图后立即恢复占位状态。
  document.querySelectorAll<HTMLCanvasElement>("[data-photo-replacement]").forEach((photo) => {
    const probe = new Image();
    probe.onload = () => {
      drawCurvedPhoto(photo, probe);
      photo.classList.add("has-photo");
    };
    probe.onerror = () => {
      photo.getContext("2d")?.clearRect(0, 0, photo.width, photo.height);
      photo.classList.remove("has-photo");
    };
    probe.src = `/media/products/photo.png?v=${Date.now()}`;
  });

  // 三张旅行照片沿用固定文件名；未上传时显示清晰的图片占位符。
  document.querySelectorAll<HTMLElement>("[data-trip-photo]").forEach((slot) => {
    const src = slot.dataset.tripPhoto;
    if (!src) return;

    const probe = new Image();
    probe.onload = () => {
      slot.style.setProperty("--trip-photo-url", `url("${probe.src}")`);
      slot.classList.add("has-photo");
    };
    probe.src = src;
  });

  const canvas = section?.querySelector<HTMLElement>(".mood-products-canvas");
  const bottomAnchoredProducts = canvas
    ? [
        ...canvas.querySelectorAll<HTMLElement>(
          ".mood-product--cookies, .mood-product--burst, .mood-product--bars",
        ),
      ]
    : [];
  let heightFrame = 0;

  const syncCanvasHeight = () => {
    if (!section || !canvas) return;

    section.classList.remove("mood-height-ready");
    canvas.classList.remove("mood-height-ready");
    canvas.style.removeProperty("--mood-content-height");

    // 先恢复 CSS 中的响应式定位，用原始画布计算三组底部插画的 top；
    // 随后把 top 固定下来，避免容器高度变化时 bottom 定位形成循环依赖。
    for (const product of bottomAnchoredProducts) {
      product.style.removeProperty("top");
      product.style.removeProperty("bottom");
    }

    section.classList.add("mood-height-measuring");
    const anchoredTops = bottomAnchoredProducts.map(
      (product) => product.offsetTop,
    );

    bottomAnchoredProducts.forEach((product, index) => {
      product.style.top = `${anchoredTops[index]}px`;
      product.style.bottom = "auto";
    });

    const canvasTop = canvas.getBoundingClientRect().top;
    let contentBottom = canvasTop + window.innerHeight;
    const measuredElements = canvas.querySelectorAll<HTMLElement>(
      ".mood-center, .mood-product, .mood-product-callout",
    );

    for (const element of measuredElements) {
      contentBottom = Math.max(
        contentBottom,
        element.getBoundingClientRect().bottom,
      );
    }

    canvas.style.setProperty(
      "--mood-content-height",
      `${Math.ceil(contentBottom - canvasTop + 24)}px`,
    );
    canvas.classList.add("mood-height-ready");
    section.classList.add("mood-height-ready");
    section.classList.remove("mood-height-measuring");
  };

  const queueCanvasHeightSync = () => {
    cancelAnimationFrame(heightFrame);
    heightFrame = requestAnimationFrame(() => {
      heightFrame = requestAnimationFrame(syncCanvasHeight);
    });
  };

  if (canvas) {
    queueCanvasHeightSync();
    addEventListener("resize", queueCanvasHeightSync, { passive: true });
    document.fonts?.ready.then(queueCanvasHeightSync);
    canvas.querySelectorAll("img").forEach((image) => {
      if (!image.complete) image.addEventListener("load", queueCanvasHeightSync, { once: true });
    });
  }

  if (section) {
    if (reduce) {
      section.classList.add("mood-head-in", "mood-b1", "mood-b2", "mood-b3");
    } else {
      const parallaxEls = [...section.querySelectorAll<HTMLElement>("[data-parallax]")];
      let ticking = false;

      const update = () => {
        ticking = false;
        const rect = section.getBoundingClientRect();
        const vh = window.innerHeight;
        if (rect.bottom < 0 || rect.top > vh) return;

        // 标题按钮：section 进入视口即淡入
        if (rect.top < vh * 0.75) section.classList.add("mood-head-in");

        // 三批元素：随 section 滚入视口的进度从上到下依次出现
        const progress = Math.min(
          Math.max((vh * 0.7 - rect.top) / rect.height, 0),
          1
        );
        if (progress > 0.15) section.classList.add("mood-b1");
        if (progress > 0.35) section.classList.add("mood-b2");
        if (progress > 0.5) section.classList.add("mood-b3");

        // 顶部 / 装饰元素：轻微 parallax（10–30px）
        // translate 属性独立于出现动画的 transform，互不冲突
        const mid = rect.top + rect.height / 2 - vh / 2;
        for (const el of parallaxEls) {
          const f = parseFloat(el.dataset.parallax || "0");
          el.style.translate = `0 ${(-mid * f).toFixed(1)}px`;
        }
      };

      addEventListener(
        "scroll",
        () => {
          if (!ticking) {
            ticking = true;
            requestAnimationFrame(update);
          }
        },
        { passive: true }
      );
      update();
    }
  }
</script>
