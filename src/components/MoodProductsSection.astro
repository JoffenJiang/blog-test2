  }

  /* 圆形食物 */
  .mood-shape-ball {
    aspect-ratio: 1;
    background: #a2734a;
    border-radius: 50%;
  }

  /* 横向食物块（巧克力 bar）：不规则圆角 */
  .mood-shape-bar {
    aspect-ratio: 2.4 / 1;
    background: #6f4a2a;
    border-radius: 44% 56% 52% 48% / 55% 45% 60% 40%;
  }

  /* 小饼干块：不规则圆角小方块 */
  .mood-shape-piece {
