---
/**
 * MoodProductsSection —— 高保真参考 Wildbran "What are you in the mood for?"
 *
 * 结构：135vh（移动端 125vh）的 section + 内部 100svh sticky scene；
 *       中间标题按钮固定视觉中心，10 个主视觉占位符围绕成不规则椭圆环。
 * 动效：标题/按钮先淡入 → 随滚动进度分三批出现（顶部排 → 两侧小件 → 底部排）；
 *       顶部元素做 10–30px 轻微 parallax；
 *       底部三张图（cookies / burst / bars）完整露出、贴近 scene 底部，位置固定不随滚动上移。
 *       prefers-reduced-motion 时全部直接显示、无位移。
 *
 * ★ 结构（对齐 Wildbran 的 .home-products-img-wrap.is--bites > img.home-products-img）：
 *   <figure class="mood-item mood-item-bites is--bites">   ← 产品视觉组 wrapper
 *     <div class="mood-product-img"> 形状/图片 </div>       ← 产品图层
 *     <figcaption class="mood-product-label"> 箭头+文字 </figcaption> ← 标签绑定在组内
 *   </figure>
 *   定位 / 批次出现 / parallax / 滚动动效全部只作用在 wrapper（figure）上，
 *   标签相对 wrapper 绝对定位，与产品图一起移动，不参与全局布局。
 *
 * ★ 替换真实图片：把 .mood-product-img 里的 <div class="mood-shape ..."> 换成
 *   <img class="mood-img" src="/media/products/xxx.png" alt="" /> 即可，
 *   wrapper 的位置 / 尺寸 / 旋转 / 动效不用改。
 */
import PillButton from "./PillButton.astro";

interface Layer {
  /** 位置与尺寸由同名 class 控制（见下方 <style>） */
  name: string;
  /** 占位符形状 class */
  shape: string;
  /** 出现批次：1 顶部排 / 2 两侧小件 / 3 底部排 */
  batch: 1 | 2 | 3;
  /** 批内错开延迟 */
  stagger: string;
  /** 滑入起点与最终旋转角 */
  vars: string;
  /** parallax 强度（顶部/装饰元素，滚动时 10–30px 位移） */
  parallax?: number;
  /** 手写标签（仅 5 个产品有） */
  label?: string;
  /** 箭头形态（1:1 参考原站：绕圈 / 波浪 / 上扬 / 下弯 / 下勾） */
  labelArrow?: keyof typeof arrows;
  /** 标签排列：箭头在文字前 / 文字在箭头前 / 箭头在文字上方 */
  labelLayout?: "arrow-text" | "text-arrow" | "arrow-over-text";
}

/** 蓝色手绘箭头（五种形态，均指向文字） */
const arrows = {
  loop:   { vb: "0 0 36 20", line: "M2 13 C 3 5, 12 4, 12 10 C 12 16, 4 16, 5 10 C 6 3, 18 4, 30 8", head: "M26 4.5 30.5 8 25 10.5" },
  zigzag: { vb: "0 0 30 22", line: "M4 3 Q 12 4 15 7 Q 7 8 6 11 Q 13 14 18 15", head: "M13.5 11 19 15.5 12.5 17.5" },
  rise:   { vb: "0 0 26 26", line: "M14 24 C 4 19, 4 8, 13 3", head: "M6.5 4.5 13.5 2.5 11 9.5" },
  curl:   { vb: "0 0 20 26", line: "M17 3 C 9 5, 9 14, 6 22", head: "M3.5 16.5 6 22.5 12.5 21" },
  hook:   { vb: "0 0 24 26", line: "M18 2 C 22 9, 20 16, 10 21", head: "M15.5 16.5 9.5 21.5 16 24.5" },
};

const layers: Layer[] = [
  { name: "mood-item-bites", shape: "mood-shape-bag", batch: 1, stagger: "0s", vars: "--sy:-80px;--rot:-6deg", parallax: 0.035, label: "Bites", labelArrow: "loop", labelLayout: "arrow-text" },
  { name: "mood-item-top-blur", shape: "mood-shape-blur", batch: 1, stagger: ".1s", vars: "--sy:-60px;--op:.45", parallax: 0.06 },
  { name: "mood-item-energy-ball", shape: "mood-shape-ball", batch: 1, stagger: ".2s", vars: "--sy:-70px", parallax: 0.05 },
  { name: "mood-item-crackers", shape: "mood-shape-box mood-shape-box--red", batch: 1, stagger: ".3s", vars: "--sy:-80px;--rot:5deg", parallax: 0.04, label: "Crackers", labelArrow: "zigzag", labelLayout: "arrow-text" },
  { name: "mood-item-left-bar", shape: "mood-shape-bar", batch: 2, stagger: "0s", vars: "--sx:-70px;--rot:-8deg", parallax: 0.055 },
  { name: "mood-item-right-cracker", shape: "mood-shape-piece", batch: 2, stagger: ".12s", vars: "--sx:70px;--rot:14deg", parallax: 0.065 },
  { name: "mood-item-cookies", shape: "mood-shape-box mood-shape-box--orange", batch: 3, stagger: "0s", vars: "--sy:80px;--rot:5deg", label: "Cookies", labelArrow: "curl", labelLayout: "arrow-over-text" },
  { name: "mood-item-burst", shape: "mood-shape-bag mood-shape-bag--green", batch: 3, stagger: ".1s", vars: "--sy:80px;--rot:3deg", label: "Energy Balls", labelArrow: "rise", labelLayout: "arrow-text" },
  { name: "mood-item-bars", shape: "mood-shape-box mood-shape-box--purple", batch: 3, stagger: ".2s", vars: "--sy:80px;--rot:4deg", label: "Bars", labelArrow: "hook", labelLayout: "text-arrow" },
  { name: "mood-item-bottom-blur", shape: "mood-shape-blur", batch: 3, stagger: ".3s", vars: "--sy:60px;--op:.45", parallax: 0.06 },
];
---

<section
  data-mood-section
  class="mood-section mood-products-section relative bg-bg"
  aria-label="What are you in the mood for?"
>
  <div class="mood-sticky mood-products-scene">
    <!-- 视觉中心：标题 + 按钮 -->
    <div class="mood-center relative z-10 flex flex-col items-center text-center">
      <h2 class="mood-title font-serif font-bold">
        What are you in<br />the mood for?
      </h2>
      <div class="mood-btn mt-8">
        <PillButton href="/our-products">Explore Our Products</PillButton>
      </div>
    </div>

    <!-- 10 个主视觉占位符（椭圆环绕，替换真实图片见文件头注释） -->
    {
      layers.map((l) => (
        <figure
          class:list={["mood-item", l.name, `is--${l.name.replace("mood-item-", "")}`]}
          data-batch={l.batch}
          data-parallax={l.parallax}
          style={`${l.vars};--stg:${l.stagger}`}
        >
          <div class="mood-product-img">
            <div class:list={["mood-shape", l.shape]} />
          </div>
          {l.label && l.labelArrow && (
            <figcaption
              class:list={[
                "mood-product-label",
                l.labelLayout === "arrow-over-text" && "mood-product-label--column",
              ]}
            >
              {l.labelLayout !== "text-arrow" && (
                <svg
                  class="mood-arrow-svg"
                  viewBox={arrows[l.labelArrow].vb}
                  fill="none"
                  aria-hidden="true"
                >
                  <path d={arrows[l.labelArrow].line} />
                  <path d={arrows[l.labelArrow].head} />
                </svg>
              )}
              <span class="mood-label-text">{l.label}</span>
              {l.labelLayout === "text-arrow" && (
                <svg
                  class="mood-arrow-svg"
                  viewBox={arrows[l.labelArrow].vb}
                  fill="none"
                  aria-hidden="true"
                >
                  <path d={arrows[l.labelArrow].line} />
                  <path d={arrows[l.labelArrow].head} />
                </svg>
              )}
            </figcaption>
          )}
        </figure>
      ))
    }
  </div>
</section>

<style>
  /* ===== 骨架：135vh section + 100svh sticky scene =====
   * section 的 overflow 用 clip 而不是 hidden：clip 不产生滚动容器，sticky 才能生效
   * 底部留白由底部三张图滚动上移产生，section 不写大 padding-bottom */
  .mood-products-section {
    height: 125vh;
    overflow: clip;
  }

  @media (min-width: 768px) {
    .mood-products-section {
      height: 135vh;
    }
  }

  .mood-products-scene {
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100svh;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* ===== 中间标题 ===== */
  .mood-title {
    max-width: 620px;
    font-size: 36px;
    line-height: 1.05;
  }

  @media (min-width: 640px) {
    .mood-title {
      font-size: 48px;
      line-height: 1;
    }
  }

  @media (min-width: 1024px) {
    .mood-title {
      font-size: 60px;
    }
  }

  /* 标题 / 按钮进场 */
  .mood-title,
  .mood-btn {
    opacity: 0;
    transform: translateY(24px);
    transition:
      opacity 0.7s ease,
      transform 0.7s ease;
  }

  .mood-btn {
    transition-delay: 0.2s;
  }

  .mood-head-in .mood-title,
  .mood-head-in .mood-btn {
    opacity: 1;
    transform: none;
  }

  /* ===== 主视觉元素：初始隐藏，按批次出现 ===== */
  .mood-item {
    position: absolute;
    margin: 0;
    opacity: 0;
    transform: translate(var(--sx, 0px), var(--sy, 0px)) scale(0.88)
      rotate(calc(var(--rot, 0deg) + 5deg));
    transition:
      opacity 0.85s ease var(--stg, 0s),
      transform 0.85s cubic-bezier(0.25, 0.7, 0.3, 1) var(--stg, 0s);
    will-change: transform;
    pointer-events: none;
  }

  .mood-b1 .mood-item[data-batch="1"],
  .mood-b2 .mood-item[data-batch="2"],
  .mood-b3 .mood-item[data-batch="3"] {
    opacity: var(--op, 1);
    transform: translate(0, 0) scale(1) rotate(var(--rot, 0deg));
  }

  /* ===== 顶部 / 两侧元素位置（保持不变） ===== */
  .mood-item-bites        { left: 5%;   top: 5%;   width: 210px; }
  .mood-item-top-blur     { left: 24%;  top: -2%;  width: 68px; }
  .mood-item-energy-ball  { left: 46%;  top: 3%;   width: 96px; }
  .mood-item-crackers     { right: 7%;  top: 4%;   width: 210px; }
  .mood-item-left-bar     { left: -4%;  top: 45%;  width: 170px; }
  .mood-item-right-cracker{ right: -1%; top: 43%;  width: 84px; }
  .mood-item-bottom-blur  { right: 25%; bottom: 4vh; width: 62px; }

  /* ===== 底部三张图：初始完整露出，贴近 scene 底部 =====
   * 距 scene 底部 3–6vh（约 24–64px），滚动时由 JS scrub 上移 */
  .mood-item-cookies {
    left: 13%;
    bottom: 6vh;
    width: clamp(210px, 18vw, 290px);
  }

  .mood-item-burst {
    left: 46%;
    bottom: 3vh;
    width: clamp(120px, 11vw, 170px);
  }

  .mood-item-bars {
    right: 10%;
    bottom: 6vh;
    width: clamp(220px, 20vw, 320px);
  }

  @media (max-width: 1023px) {
    .mood-item-bites        { width: 150px; }
    .mood-item-top-blur     { width: 52px; }
    .mood-item-energy-ball  { width: 72px; }
    .mood-item-crackers     { width: 150px; }
    .mood-item-left-bar     { width: 120px; }
    .mood-item-right-cracker{ width: 62px; }
    .mood-item-cookies      { width: clamp(150px, 18vw, 290px); }
    .mood-item-burst        { width: clamp(96px, 11vw, 170px); }
    .mood-item-bars         { width: clamp(160px, 20vw, 320px); }
    .mood-item-bottom-blur  { width: 48px; }
  }

  @media (max-width: 639px) {
    .mood-item-bites        { width: 104px; left: 2%; }
    .mood-item-top-blur     { width: 40px; }
    .mood-item-energy-ball  { width: 54px; }
    .mood-item-crackers     { width: 104px; right: 2%; }
    .mood-item-left-bar,
    .mood-item-right-cracker { display: none; }
    .mood-item-cookies      { width: 116px; left: 6%; bottom: 5vh; }
    .mood-item-burst        { width: 78px; left: 45%; bottom: 3vh; }
    .mood-item-bars         { width: 126px; right: 5%; bottom: 5vh; }
    .mood-item-bottom-blur  { width: 36px; }
  }

  /* ===== 产品图层：占满 wrapper 宽度，后续在这里面换真实 <img> ===== */
  .mood-product-img {
    width: 100%;
  }

  /* ===== 形状占位符（纯 CSS，后续整体换成 <img class="mood-img">） ===== */
  .mood-shape {
    width: 100%;
  }

  .mood-img {
    display: block;
    width: 100%;
    height: auto;
  }

  /* 包装袋：圆角矩形 + 顶部封口 */
  .mood-shape-bag {
    aspect-ratio: 4 / 5;
    background: #e6cf9d;
    border-radius: 14% / 11%;
    position: relative;
  }

  .mood-shape-bag::before {
    content: "";
    position: absolute;
    left: 4%;
    right: 4%;
    top: 0;
    height: 9%;
    background: #d0b276;
    border-radius: 999px;
  }

  .mood-shape-bag--green {
    background: #ccd6ad;
  }

  .mood-shape-bag--green::before {
    background: #aebb85;
  }

  /* 盒子：圆角矩形 + 左侧深色棱面（轻微 3D 感） */
  .mood-shape-box {
    aspect-ratio: 3 / 4;
    background: #f1e6cf;
    border-radius: 6% / 4.5%;
    position: relative;
  }

  .mood-shape-box::before {
    content: "";
    position: absolute;
    left: 0;
    top: 2%;
    bottom: 2%;
    width: 11%;
    border-radius: 6px 0 0 6px;
    transform: skewY(-4deg);
  }

  .mood-shape-box--red::before {
    background: #bc4a35;
  }

  .mood-shape-box--orange {
    background: #f4ead6;
  }

  .mood-shape-box--orange::before {
    background: #cc8544;
  }

  .mood-shape-box--purple {
    aspect-ratio: 1;
    background: #e7dbf0;
  }

  .mood-shape-box--purple::before {
    background: #a687c6;
  }

  /* 圆形食物 */
  .mood-shape-ball {
    aspect-ratio: 1;
    background: #a2734a;
    border-radius: 50%;
  }

  /* 横向食物块（巧克力 bar）：不规则圆角 */
  .mood-shape-bar {
    aspect-ratio: 2.4 / 1;
    background: #6f4a2a;
    border-radius: 44% 56% 52% 48% / 55% 45% 60% 40%;
  }

  /* 小饼干块：不规则圆角小方块 */
  .mood-shape-piece {
    aspect-ratio: 1 / 0.9;
    background: #d9b98c;
    border-radius: 38% 62% 55% 45% / 48% 52% 45% 55%;
  }

  /* 灰色模糊圆形装饰 */
  .mood-shape-blur {
    aspect-ratio: 1;
    background: #b3afa6;
    border-radius: 50%;
    filter: blur(6px);
  }

  /* ===== 手写标签：绑定在产品视觉组内部 =====
   * 相对 wrapper（figure.mood-item）绝对定位，紧贴产品图，
   * 与产品图一起定位 / 出现 / parallax，不基于 scene 布局 */
  .mood-product-label {
    position: absolute;
    display: flex;
    align-items: center;
    gap: 7px;
    white-space: nowrap;
    margin: 0;
  }

  /* Cookies：箭头在文字上方 */
  .mood-product-label--column {
    flex-direction: column;
    align-items: flex-start;
    gap: 3px;
  }

  .mood-label-text {
    font-family: var(--font-hand);
    font-size: 22px;
    line-height: 1;
    color: var(--color-ink);
  }

  .mood-arrow-svg {
    display: block;
    width: 32px;
    height: auto;
    flex-shrink: 0;
    color: var(--color-blue);
  }

  .mood-arrow-svg path {
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  @media (max-width: 1023px) {
    .mood-label-text {
      font-size: 18px;
    }

    .mood-arrow-svg {
      width: 26px;
    }
  }

  /* 各产品组内标签的位置：箭头尾部贴住图片边缘，从图片向外画、头指向文字
   * （对照原站五组：Bites 右下 / Crackers 左下方 / Energy Balls 上方 /
   *   Cookies 左下 / Bars 右下，文字都落在箭头所指方向） */
  .is--bites .mood-product-label    { right: -42%; bottom: 12%; }
  .is--crackers .mood-product-label { left: 14%; bottom: -15%; }
  .is--cookies .mood-product-label  { left: -12%; bottom: -27%; }
  .is--burst .mood-product-label    { left: -8%; top: -28%; }
  .is--bars .mood-product-label     { right: -4%; bottom: -22%; }

  @media (max-width: 639px) {
    .is--crackers .mood-product-label { left: 0; bottom: -26%; }
    .is--cookies .mood-product-label  { left: -14%; bottom: -26%; }
    .is--bars .mood-product-label     { right: 4%; bottom: -26%; }
  }

  /* ===== 关闭动效：全部直接显示、无位移 ===== */
  @media (prefers-reduced-motion: reduce) {
    .mood-title,
    .mood-btn {
      opacity: 1;
      transform: none;
      transition: none;
    }

    .mood-item {
      opacity: var(--op, 1);
      transform: rotate(var(--rot, 0deg));
      transition: none;
    }
  }
</style>

<script>
  const section = document.querySelector<HTMLElement>("[data-mood-section]");
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (section) {
    if (reduce) {
      section.classList.add("mood-head-in", "mood-b1", "mood-b2", "mood-b3");
    } else {
      const parallaxEls = [...section.querySelectorAll<HTMLElement>("[data-parallax]")];
      let ticking = false;

      const update = () => {
        ticking = false;
        const rect = section.getBoundingClientRect();
        const vh = window.innerHeight;
        if (rect.bottom < 0 || rect.top > vh) return;

        // 标题按钮：section 进入视口即淡入
        if (rect.top < vh * 0.75) section.classList.add("mood-head-in");

        // 三批元素：随 section 内滚动进度从上到下依次出现
        const total = Math.max(rect.height - vh, 1);
        const progress = Math.min(Math.max(-rect.top / total, 0), 1);
        if (progress > 0.05) section.classList.add("mood-b1");
        if (progress > 0.38) section.classList.add("mood-b2");
        if (progress > 0.6) section.classList.add("mood-b3");

        // 顶部 / 装饰元素：轻微 parallax（10–30px）
        // translate 属性独立于出现动画的 transform，互不冲突
        const mid = rect.top + rect.height / 2 - vh / 2;
        for (const el of parallaxEls) {
          const f = parseFloat(el.dataset.parallax || "0");
          el.style.translate = `0 ${(-mid * f).toFixed(1)}px`;
        }
      };

      addEventListener(
        "scroll",
        () => {
          if (!ticking) {
            ticking = true;
            requestAnimationFrame(update);
          }
        },
        { passive: true }
      );
      update();
    }
  }
</script>
