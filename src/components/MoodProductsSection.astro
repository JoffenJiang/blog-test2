            )}
          </div>
        </figure>
      ))
    }
  </div>
</section>

<style>
  /* ===== 骨架：视觉舞台 + 底部米白退场空间 =====
   * min-height = 100svh（主要视觉舞台）+ clamp(...)（Wildbran 式退场空间）
   * 下一个暗色板块在退场空间之后正常衔接，不覆盖本区 */
  .mood-products-section {
    --mood-exit-buffer: clamp(140px, 16svh, 240px);
    --mood-bottom-safe: clamp(120px, 15svh, 220px);
    position: relative;
    z-index: 1;
    background: var(--color-bg);
    min-height: calc(100svh + var(--mood-exit-buffer));
    /* 与上一板块（视频首屏）保留的距离 = 底部退场留白，与下方职业发展板块的间距一致 */
    margin-top: var(--mood-exit-buffer);
    overflow-x: clip;
    overflow-y: visible;
  }

  .mood-products-canvas {
    position: relative;
    min-height: calc(100svh + var(--mood-exit-buffer));
    background: var(--color-bg);
    /* 只裁横向（收住 left-bar / right-cracker 的两侧溢出），
     * 纵向放开：避免顶部装饰（top-blur / energy-ball）在 canvas 上边缘
     * 被 overflow:hidden 削出一条突兀的硬直线 */
    overflow-x: clip;
    overflow-y: visible;
    display: flex;
    align-items: flex-start;
    justify-content: center;
  }

  /* ===== 中间标题：居中在首屏 100svh 内 ===== */
  .mood-center {
    position: relative;
    z-index: 10;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
  }

  /* 标题字号统一约 36px（移动端略小） */
  .mood-title {
    max-width: 620px;
    font-size: 30px;
    line-height: 1.2;
  }

  @media (min-width: 640px) {
    .mood-title {
      font-size: 36px;
    }
  }

  /* 标题下副文案：15px 说明句 */
  .mood-sub {
    margin-top: 14px;
    max-width: 520px;
    font-size: 15px;
    line-height: 1.9;
    color: rgba(36, 36, 36, 0.65);
